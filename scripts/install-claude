#!/usr/bin/env node
// Installs this checkout into Claude Code for the person running it. Unlike scripts/setup,
// it writes outside the checkout: two skill links in ~/.claude/skills (or $CLAUDE_CONFIG_DIR/skills)
// and, unless --no-panel, the panel plugin at user scope. Agents must not run it (AGENTS.md);
// its tests use a temporary HOME and CLAUDE_CONFIG_DIR, never the user's installation.
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { spawnSync } = require('node:child_process');

const ROOT = path.resolve(__dirname, '..');
const args = process.argv.slice(2);
if (args.includes('--help')) {
  console.log('Usage: scripts/install-claude [--no-panel]\nPrepares this checkout, links both skills and installs the Claude Code panel (on by default).\n--no-panel  Install the skills without the panel.\nExisting skill entries are never replaced. Preferences keep their defaults.');
  process.exit(0);
}
if (args.some((arg) => arg !== '--no-panel')) {
  console.error('Unknown option. Use --help for usage.');
  process.exit(1);
}
const panel = !args.includes('--no-panel');
const skillsDir = path.join(process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude'), 'skills');
const links = ['engineering-router', 'skill-selector'].map((name) => ({
  source: path.join(ROOT, 'skills', name),
  target: path.join(skillsDir, name),
}));
const realpath = (p) => {
  try { return fs.realpathSync(p); } catch { return null; }
};
// A link counts as ours when it resolves to this checkout's skill, whatever path it was written with.
function alreadyLinked({ source, target }) {
  return fs.lstatSync(target).isSymbolicLink() && realpath(target) === realpath(source);
}
function run(command, commandArgs) {
  const result = spawnSync(command, commandArgs, { cwd: ROOT, stdio: 'inherit' });
  if (result.error) console.error(`${command}: ${result.error.message}`);
  if (result.status !== 0) process.exit(1);
}
// Check conflicts and prerequisites before changing anything.
for (const link of links) {
  link.exists = Boolean(fs.lstatSync(link.target, { throwIfNoEntry: false }));
  if (link.exists && !alreadyLinked(link)) {
    console.error(`Left unchanged: ${link.target}\nAn existing skill occupies this path. See docs/claude-code.md before retrying.`);
    process.exit(1);
  }
}
if (panel) run('claude', ['--version']);
run(path.join(ROOT, 'scripts/setup'), []);
fs.mkdirSync(skillsDir, { recursive: true });
for (const link of links) {
  if (link.exists) {
    console.log(`Already linked: ${link.target}`);
  } else {
    fs.symlinkSync(link.source, link.target, 'dir');
    console.log(`Linked: ${link.target}`);
  }
}
if (panel) {
  run('claude', ['plugin', 'marketplace', 'add', ROOT]);
  run('claude', ['plugin', 'install', 'engineering-router-panel@engineering-skills-router']);
}
console.log(`\nReady. Open Claude Code in your project and run /engineering-router <task>.${panel ? '\nIn an existing session, run /reload-plugins first.' : ''}`);
