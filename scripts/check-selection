#!/usr/bin/env node
// Usage: scripts/check-selection [--target <repo>] <file>
// Checks the references in a skill-selector proposal: the file is the selection JSON, or a
// Markdown answer holding it as the last ```json block. Each selected phase needs a reason and a
// default; each pick (default and at most two alternatives) needs a reason and must be an `ok`
// candidate of `list-skills` for its phase: cataloged, personal or (with --target)
// project, present, not excluded, never a guide. A missing phase needs a reason. Judging fit is
// the selector's job; this only proves every proposed step could run. Reads only.
//
// {
//   "phases":  [{ "phase": "review", "reason": "...", "default": { "skill": "<id>", "reason": "..." },
//                 "alternatives": [{ "skill": "<id>", "reason": "..." }] }],
//   "missing": [{ "phase": "release", "reason": "..." }]
// }
const fs = require('node:fs');
const Catalog = require('./lib/catalog');

const { target, args } = Catalog.targetArg(process.argv.slice(2));
const file = args[0];
if (!file || !fs.existsSync(file)) {
  console.error(`usage: scripts/check-selection [--target <repo>] <file>${file ? `\nnot found: ${file}` : ''}`);
  process.exit(1);
}
const text = fs.readFileSync(file, 'utf8');
const blocks = [...text.matchAll(/```json\r?\n([\s\S]*?)```/g)].map((m) => m[1]);
let selection;
try {
  selection = JSON.parse(blocks.length > 0 ? blocks.at(-1) : text);
} catch (e) {
  console.error(`${file}: no selection JSON: ${e.message}`);
  process.exit(1);
}

const errors = [];
const categories = Catalog.categories();
const skills = Catalog.skills(target);
const hasReason = (o) => typeof o?.reason === 'string' && o.reason.trim() !== '';
const phases = Catalog.arr(selection.phases);
const missing = Catalog.arr(selection.missing);

for (const p of phases) {
  const name = p?.phase;
  if (!Object.hasOwn(categories, name)) { errors.push(`${name}: unknown phase`); continue; }
  if (!hasReason(p)) errors.push(`${name}: needs a reason`);
  if (missing.some((m) => m?.phase === name)) errors.push(`${name}: both selected and missing`);
  if (!p.default) { errors.push(`${name}: needs a default (or list the phase under missing)`); continue; }
  const alternatives = Catalog.arr(p.alternatives);
  if (alternatives.length > 2) errors.push(`${name}: at most two alternatives`);
  const seen = new Set();
  for (const [role, pick] of [['default', p.default], ...alternatives.map((a) => ['alternative', a])]) {
    const id = pick?.skill;
    const where = `${name}: ${role} ${id}`;
    if (seen.has(id)) errors.push(`${where}: repeats another pick`);
    seen.add(id);
    if (!hasReason(pick)) errors.push(`${where}: needs a reason`);
    const problem = Catalog.pickProblem(id, [name], skills);
    if (problem) errors.push(`${where}: ${problem.message}`);
  }
}
for (const m of missing) {
  if (!Object.hasOwn(categories, m?.phase)) errors.push(`missing ${m?.phase}: unknown phase`);
  if (!hasReason(m)) errors.push(`missing ${m?.phase}: needs a reason`);
}

for (const e of errors) console.log(`error: ${e}`);
console.log(errors.length === 0 ? `selection OK (${phases.length} phase(s), ${missing.length} missing)` : `${errors.length} error(s)`);
process.exit(errors.length === 0 ? 0 : 1);
