#!/usr/bin/env node
// Usage: scripts/check-selection [--target <repo>] [--reselect] <file>
// Checks the references in a skill-selector proposal: the file is the selection JSON, or a
// Markdown answer holding it as the last ```json block. Each selected phase needs a reason and a
// default; each pick (default and at most two alternatives) needs a reason and must be an `ok`
// candidate of `list-skills` for its phase: cataloged, personal or (with --target)
// project, present, not excluded, never a guide. Every phase of the router's default flow
// (DEFAULT_FLOW) is accounted for: selected, omitted with a reason, or missing with a reason.
// Judging fit is the selector's job; this only proves every proposed step could run and no
// required phase was silently dropped. Reads only.
//
// {
//   "phases":  [{ "phase": "review", "reason": "...", "default": { "skill": "<id>", "reason": "..." },
//                 "alternatives": [{ "skill": "<id>", "reason": "..." }],
//                 "prerequisites": ["..."], "cost": "..." | null, "tie": "..." | null }],
//   "omitted": [{ "phase": "planning", "reason": "..." }],
//   "missing": [{ "phase": "release", "reason": "..." }],
//   "capabilities": ["subagents", "isolated-outputs"]   the harness's, as the selector recorded them
// }
// A `cost: high` skill (pstack/arena) needs a reason starting "High cost" wherever it is picked,
// and is a default only with `"explicit": true` (the user chose it). A pick whose `requires`
// names a harness capability (HARNESS_CAPABILITIES) needs it in `capabilities`.
// A decided phase (ADR 0005, lib/decided.js) keeps its skill as the default, with its origin as
// that default's reason. Another default is refused unless the user asked for it: `"explicit": true`
// on a default they named, or --reselect when they asked to select every phase again. A decided
// skill the harness cannot run may be replaced.
const fs = require('node:fs');
const Catalog = require('./lib/catalog');
const Decided = require('./lib/decided');
const { lastJsonBlock } = require('./lib/json-block');

const { DEFAULT_FLOW } = Catalog;

const { target, args: given } = Catalog.targetArg(process.argv.slice(2));
const reselect = given.includes('--reselect');
const args = given.filter((a) => a !== '--reselect');
Catalog.requireConfig();
const file = args[0];
if (!file || !fs.existsSync(file)) {
  console.error(`usage: scripts/check-selection [--target <repo>] [--reselect] <file>${file ? `\nnot found: ${file}` : ''}`);
  process.exit(1);
}
const text = fs.readFileSync(file, 'utf8');
let selection;
try {
  selection = JSON.parse(lastJsonBlock(text) ?? text);
} catch (e) {
  console.error(`${file}: no selection JSON: ${e.message}`);
  process.exit(1);
}

const errors = [];
const categories = Catalog.categories();
const skills = Catalog.skills(target);
const isStrings = (v) => Array.isArray(v) && v.every((x) => typeof x === 'string');
const hasReason = (o) => typeof o?.reason === 'string' && o.reason.trim() !== '';
const phases = Catalog.arr(selection.phases);
const missing = Catalog.arr(selection.missing);
const omitted = Catalog.arr(selection.omitted);
const { capabilities } = selection;
if (capabilities !== undefined && !isStrings(capabilities)) errors.push('capabilities must be a list of strings');

const isNote = (v) => v == null || typeof v === 'string';
const history = reselect ? [] : Decided.runs(target);
// What is wrong with `pick` as the default of `phase` when the phase is decided, or null.
const decidedProblem = (phase, pick) => {
  if (reselect || pick?.explicit === true) return null;
  const decision = Decided.decide(phase, { target, skills, history });
  if (!decision.skill) return null;
  if (pick?.skill === decision.skill)
    return pick.reason === decision.origin ? null : `a decided phase's reason is its origin: ${JSON.stringify(decision.origin)}`;
  if (isStrings(capabilities) && Catalog.capabilityProblem(decision.skill, capabilities, skills)) return null;
  return `replaces the decided skill ${decision.skill} (${decision.origin}): keep it, or mark this default "explicit": true when the user named it`;
};
const selected = new Set();
for (const p of phases) {
  const name = p?.phase;
  if (!Object.hasOwn(categories, name)) { errors.push(`${name}: unknown phase`); continue; }
  // Each phase has one selection: there is no second review (ADR 0001).
  if (p.step != null) { errors.push(`${name}: step ${p.step}: a phase has one selection, with no step of its own`); continue; }
  if (selected.has(name)) errors.push(`${name}: selected twice`);
  selected.add(name);
  if (!hasReason(p)) errors.push(`${name}: needs a reason`);
  if (missing.some((m) => m?.phase === name)) errors.push(`${name}: both selected and missing`);
  if (omitted.some((m) => m?.phase === name)) errors.push(`${name}: both selected and omitted`);
  if (p.prerequisites !== undefined && !isStrings(p.prerequisites)) errors.push(`${name}: prerequisites must be a list of strings`);
  for (const key of ['cost', 'tie']) if (!isNote(p[key])) errors.push(`${name}: ${key} must be a string or null`);
  if (!p.default) { errors.push(`${name}: needs a default (or list the phase under missing)`); continue; }
  const alternatives = Catalog.arr(p.alternatives);
  if (alternatives.length > 2) errors.push(`${name}: at most two alternatives`);
  const seen = new Set();
  for (const [role, pick] of [['default', p.default], ...alternatives.map((a) => ['alternative', a])]) {
    const id = pick?.skill;
    const where = `${name}: ${role} ${id}`;
    if (seen.has(id)) errors.push(`${where}: repeats another pick`);
    seen.add(id);
    if (!hasReason(pick)) errors.push(`${where}: needs a reason`);
    const problem = Catalog.pickProblem(id, [name], skills);
    if (problem) { errors.push(`${where}: ${problem.message}`); continue; }
    const decided = role === 'default' ? decidedProblem(name, pick) : null;
    if (decided) errors.push(`${where}: ${decided}`);
    if (skills[id]?.cost === 'high') {
      const cost = Catalog.costProblem(id, pick.reason, skills);
      if (cost && hasReason(pick)) errors.push(`${where}: ${cost}`);
      if (role === 'default' && pick.explicit !== true)
        errors.push(`${where}: high cost: keep a single-implementation default unless the user chose it ("explicit": true)`);
    }
    // Invalid capabilities are reported once, above; they prove nothing about a pick.
    if (capabilities !== undefined && !isStrings(capabilities)) continue;
    const unmet = Catalog.capabilityProblem(id, capabilities, skills);
    if (unmet) errors.push(`${where}: ${unmet}`);
  }
}
for (const [label, list] of [['missing', missing], ['omitted', omitted]]) {
  for (const m of list) {
    if (!Object.hasOwn(categories, m?.phase)) errors.push(`${label} ${m?.phase}: unknown phase`);
    if (!hasReason(m)) errors.push(`${label} ${m?.phase}: needs a reason`);
  }
}
for (const phase of DEFAULT_FLOW) {
  if (![...phases, ...omitted, ...missing].some((p) => p?.phase === phase))
    errors.push(`${phase}: a default-flow phase must be selected, omitted with a reason, or missing`);
}

for (const e of errors) console.log(`error: ${e}`);
console.log(errors.length === 0 ? `selection OK (${phases.length} phase(s), ${missing.length} missing)` : `${errors.length} error(s)`);
process.exit(errors.length === 0 ? 0 : 1);
