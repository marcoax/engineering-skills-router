#!/usr/bin/env node
// Runs the scripts against a scratch copy of the catalog, scratch target repos and a scratch
// personal folder to check error detection, preference ordering and project and personal
// catalogs, then the root resolver, check-state and the Pi adapter tests. Leaves the real
// catalog untouched.
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const { spawnSync } = require('node:child_process');

const ROOT = path.resolve(__dirname, '..');
const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'router-selftest-'));
process.on('exit', () => fs.rmSync(tmp, { recursive: true, force: true }));
const STATE_MD = 'skills/engineering-router/state.md';
// Never the maintainer's configuration: no explicit location, and an empty scratch XDG config root.
delete process.env.ENGINEERING_ROUTER_CONFIG;
process.env.XDG_CONFIG_HOME = path.join(tmp, 'xdg config');
for (const dir of ['catalog', 'scripts', 'skills']) fs.cpSync(path.join(ROOT, dir), path.join(tmp, dir), { recursive: true });
fs.mkdirSync(path.join(tmp, 'config'));
for (const dir of ['vendors', 'node_modules']) fs.symlinkSync(path.join(ROOT, dir), path.join(tmp, dir));

const prefsFile = path.join(tmp, 'config/preferences.yaml');
const fail = (msg) => { console.log(`FAIL: ${msg}`); process.exit(1); };
const run = (script, ...args) => {
  const r = spawnSync(path.join(tmp, 'scripts', script), args, { encoding: 'utf8' });
  return { ok: r.status === 0, out: r.stdout + r.stderr };
};

// Layout: the skills CLI and Pi must both discover exactly the router and the selector, under
// skills/, never a vendor skill.
const INSTALLED_SKILLS = ['engineering-router', 'skill-selector'];
const skillFiles = [];
const walk = (dir) => {
  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
    if (e.name.startsWith('.') || (dir === ROOT && ['vendors', 'node_modules'].includes(e.name))) continue;
    const p = path.join(dir, e.name);
    if (e.isDirectory()) walk(p);
    else if (e.name === 'SKILL.md') skillFiles.push(path.relative(ROOT, p));
  }
};
walk(ROOT);
{
  const want = INSTALLED_SKILLS.map((name) => path.join('skills', name, 'SKILL.md'));
  if (JSON.stringify(skillFiles.sort()) !== JSON.stringify(want)) {
    fail(`expected exactly ${want.join(', ')} outside vendors/; found: ${skillFiles.join(', ') || 'none'}`);
  }
  for (const name of INSTALLED_SKILLS) {
    const front = fs.readFileSync(path.join(ROOT, 'skills', name, 'SKILL.md'), 'utf8').match(/^---\n([\s\S]*?)\n---/)?.[1] ?? '';
    if (!new RegExp(`^name: ${name}$`, 'm').test(front)) fail(`skills/${name}/SKILL.md should be named ${name}`);
  }
  // Each installable skill finds its checkout with the same resolver.
  const resolver = fs.readFileSync(path.join(ROOT, 'skills/engineering-router/resolve-root.js'), 'utf8');
  if (fs.readFileSync(path.join(ROOT, 'skills/skill-selector/resolve-root.js'), 'utf8') !== resolver)
    fail('skills/skill-selector/resolve-root.js should be identical to the router\'s');
}
const piSkills = JSON.stringify(JSON.parse(fs.readFileSync(path.join(ROOT, 'package.json'), 'utf8')).pi?.skills);
if (piSkills !== '["./skills"]') fail(`package.json pi.skills should be exactly ["./skills"]; found: ${piSkills}`);

if (!run('validate-catalog').ok) fail('clean catalog should validate');

fs.writeFileSync(prefsFile, `preferences:
  review:
    prefer: [addyosmani/code-review-and-quality]
    model: openai
  exclude: [mattpocock/code-review]
  update_check_days: 0
  models:
    claude: claude-bridge/claude-opus-5-5
    openai: openai-codex/gpt-6-sol
  primary: claude
  effort: medium
`);
if (!run('validate-catalog').ok) fail('valid preferences should validate');
let { out } = run('list-skills', 'review');
if (!/^1\. addyosmani\/code-review-and-quality {2}\[preference, ok\]/m.test(out)) fail('preference should rank first');
if (!out.includes('mattpocock/code-review  [vendor, excluded]')) fail('exclude should mark skill');
// Vendor rankings are retired: no listing shows a ranking tier.
if (/\[(preferred|fallback|other),/.test(run('list-skills', 'review', 'implementation').out)) fail('list-skills should not show ranking tiers');

fs.writeFileSync(prefsFile, 'preferences:\n  review:\n    prefer: [nobody/nothing]\n');
if (run('validate-catalog').ok) fail('unknown preferred skill should fail');

for (const [line, msg] of [
  ['context_threshold: -1', 'context_threshold: must be an integer >= 0'],
  ['context_threshold: 1.5', 'context_threshold: must be an integer >= 0'],
  ['context_threshold: .inf', 'context_threshold: must be an integer >= 0'],
  ['context_threshold: never', 'context_threshold: must be an integer >= 0'],
  ['update_check_days: -1', 'update_check_days: must be an integer >= 0'],
  ['update_check_days: soon', 'update_check_days: must be an integer >= 0'],
  ['models:\n    claude: opus', "models.claude: must be 'provider/model-id'"],
  ['models:\n    gemini: google/gemini', "models: unknown family 'gemini'"],
  ['primary: gemini', 'primary: must be claude | openai'],
  ['effort: max', 'effort: must be low | medium | high'],
  ['models:\n    effort: medium', "models: unknown family 'effort'"],
  ['implementation:\n    model: anthropic/claude-sonnet-5-5', 'implementation.model: must be claude | openai'],
]) {
  fs.writeFileSync(prefsFile, `preferences:\n  ${line}\n`);
  const r = run('validate-catalog');
  if (r.ok || !r.out.includes(msg)) fail(`expected: ${msg}`);
}
fs.rmSync(prefsFile);

// The adapters read the same checkout preference as the validator.
for (const value of [0, 150000, 180000]) {
  fs.writeFileSync(prefsFile, `preferences:\n  context_threshold: ${value}\n`);
  if (!run('validate-catalog').ok) fail('valid context_threshold should validate');
  if (run('context-threshold').out.trim() !== String(value)) fail('context threshold bridge should follow this checkout');
}
fs.rmSync(prefsFile);
if (run('context-threshold').out.trim() !== '150000') fail('missing threshold defaults to 150000');

// Project catalog: a scratch target repo lists its own skill in docs/agents/skills.yaml.
const targetRepo = (yaml) => {
  const dir = fs.mkdtempSync(path.join(tmp, 'project-'));
  fs.mkdirSync(path.join(dir, '.claude/skills/fw'), { recursive: true });
  fs.writeFileSync(path.join(dir, '.claude/skills/fw/SKILL.md'), '# fw\n');
  if (yaml !== undefined) {
    fs.mkdirSync(path.join(dir, 'docs/agents'), { recursive: true });
    fs.writeFileSync(path.join(dir, 'docs/agents/skills.yaml'), `skills:\n${yaml}`);
  }
  return dir;
};
// One catalog entry, shaped the same in the project and the personal catalog.
const skillEntry = ({ id, skillPath, cats, extra = '' }) =>
  `  ${id}:\n    path: ${skillPath}\n    categories: ${cats}\n    use_when:\n      - the task fits\n${extra}`;
const projectSkill = (o = {}) => skillEntry({ id: 'project/fw', skillPath: '.claude/skills/fw/SKILL.md', cats: '[framework-review]', ...o });
{
  const repo = targetRepo(projectSkill());
  ({ out } = run('list-skills', '--target', repo, 'framework-review'));
  if (!/^1\. project\/fw {2}\[project, ok\]$/m.test(out)) fail(`list-skills --target should list project/fw as ok\n${out}`);
  if (!out.includes(`path: ${path.join(repo, '.claude/skills/fw/SKILL.md')}`)) fail(`project path should resolve against the target\n${out}`);

  // framework-review is project-only: no preference or tagged catalog skill fills it,
  // and validate-catalog rejects a catalog skill tagged with it.
  const skillsFile = path.join(tmp, 'catalog/skills.yaml');
  const skillsText = fs.readFileSync(skillsFile, 'utf8');
  fs.writeFileSync(skillsFile, skillsText.replace(/(mattpocock\/code-review:\n(?: {4}.*\n)*? {4}categories: )\[review\]/,
    '$1[review, framework-review]'));
  fs.writeFileSync(prefsFile, 'preferences:\n  framework-review:\n    prefer: [addyosmani/code-review-and-quality]\n');
  ({ out } = run('list-skills', '--target', repo, 'framework-review'));
  const order = [...out.matchAll(/^\d+\. (\S+) {2}\[(\w+)/gm)].map((m) => `${m[1]} ${m[2]}`).join(', ');
  if (order !== 'project/fw project') fail(`list-skills --target framework-review: expected only project/fw; got ${order}`);
  const r = run('validate-catalog');
  const msg = "mattpocock/code-review: only project skills may fill 'framework-review'";
  if (r.ok || !r.out.includes(`error: ${msg}`)) fail(`validate-catalog, expected: ${msg}\ngot:\n${r.out}`);
  fs.writeFileSync(skillsFile, skillsText);
  fs.rmSync(prefsFile);
}
{
  const repo = targetRepo();
  if (run('list-skills', '--target', repo).out !== run('list-skills').out) fail('list-skills --target without a project catalog should change nothing');
  if (!run('validate-catalog', '--target', repo).ok) fail('validate-catalog --target without a project catalog should pass');
}
// Only project/ ids merge: a project entry cannot replace a catalog skill.
if (run('list-skills', '--target', targetRepo(projectSkill({ id: 'mattpocock/code-review', cats: '[review]' })), 'review').out
  !== run('list-skills', 'review').out) fail('list-skills --target should ignore project entries with catalog ids');
if (!run('validate-catalog', '--target', targetRepo(projectSkill())).ok) fail('valid project catalog should validate');
// Preferences name catalog skills only, so one cannot carry a project skill into another phase.
fs.writeFileSync(prefsFile, 'preferences:\n  review:\n    prefer: [project/fw]\n');
{
  const repo = targetRepo(projectSkill());
  const r = run('validate-catalog', '--target', repo);
  if (r.ok || !r.out.includes('error: preferences.review: unknown skill project/fw'))
    fail(`validate-catalog --target should reject a preference for a project skill\n${r.out}`);
  if (run('list-skills', '--target', repo, 'review').out.includes('project/fw'))
    fail('list-skills --target should not offer a preferred project skill for review');
}
fs.rmSync(prefsFile);
for (const [skill, msg] of [
  [{ skillPath: '.claude/skills/nope/SKILL.md' }, 'docs/agents/skills.yaml: project/fw: path not found .claude/skills/nope/SKILL.md'],
  [{ cats: '[not-a-category]' }, "docs/agents/skills.yaml: project/fw: invalid category 'not-a-category'"],
  [{ cats: '[]' }, 'docs/agents/skills.yaml: project/fw: no categories'],
  [{ id: 'acme/fw' }, "docs/agents/skills.yaml: acme/fw: id must start with 'project/'"],
  [{ extra: '    complexity: [huge]\n' }, "docs/agents/skills.yaml: project/fw: invalid complexity 'huge'"],
  [{ extra: '    invokes: [nobody/nothing]\n' }, 'docs/agents/skills.yaml: project/fw: invokes unknown skill nobody/nothing'],
  [[{}, {}], 'docs/agents/skills.yaml: duplicate skill id: project/fw'],
]) {
  const r = run('validate-catalog', '--target', targetRepo([skill].flat().map(projectSkill).join('')));
  if (r.ok || !r.out.includes(`error: ${msg}`)) fail(`validate-catalog --target, expected: ${msg}\ngot:\n${r.out}`);
}
// A project path must stay inside the target, even when the file it names exists.
const outsideSkill = path.join(tmp, 'outside/SKILL.md');
fs.mkdirSync(path.dirname(outsideSkill));
fs.writeFileSync(outsideSkill, '# outside\n');
for (const skillPath of [outsideSkill, '../outside/SKILL.md']) {
  const repo = targetRepo(projectSkill({ skillPath }));
  const r = run('validate-catalog', '--target', repo);
  const msg = `docs/agents/skills.yaml: project/fw: path outside the target repo: ${skillPath}`;
  if (r.ok || !r.out.includes(`error: ${msg}`)) fail(`validate-catalog --target, expected: ${msg}\ngot:\n${r.out}`);
  ({ out } = run('list-skills', '--target', repo, 'framework-review'));
  if (!/^1\. project\/fw {2}\[project, missing\]$/m.test(out)) fail(`list-skills --target should list ${skillPath} as missing\n${out}`);
}
// A project skill tagged with another phase comes after a user preference and before the vendor skills.
{
  const repo = targetRepo(projectSkill({ cats: '[framework-review, review]' }));
  if (!run('validate-catalog', '--target', repo).ok) fail('a project skill may fill review too');
  fs.writeFileSync(prefsFile, 'preferences:\n  review:\n    prefer: [addyosmani/code-review-and-quality]\n');
  ({ out } = run('list-skills', '--target', repo, 'review'));
  const order = [...out.matchAll(/^\d+\. (\S+) {2}\[(\w+)/gm)].slice(0, 3).map((m) => `${m[1]} ${m[2]}`).join(', ');
  const expected = 'addyosmani/code-review-and-quality preference, project/fw project, mattpocock/code-review vendor';
  if (order !== expected) fail(`list-skills --target review: expected ${expected}; got ${order}`);
  fs.rmSync(prefsFile);
}

// Personal catalog: config/personal-skills.yaml lists skills kept under preferences.personal_path.
const personalDir = path.join(tmp, 'personal');
fs.mkdirSync(path.join(personalDir, 'notes'), { recursive: true });
fs.writeFileSync(path.join(personalDir, 'notes/SKILL.md'), '# notes\n');
const personalFile = path.join(tmp, 'config/personal-skills.yaml');
const personalSkill = (o = {}) => skillEntry({ id: 'personal/notes', skillPath: 'notes/SKILL.md', cats: '[documentation]', ...o });
const withPersonal = (yaml, prefs = `  personal_path: ${personalDir}\n`) => {
  fs.writeFileSync(prefsFile, `preferences:\n${prefs}`);
  fs.writeFileSync(personalFile, `skills:\n${yaml}`);
};
withPersonal(personalSkill());
({ out } = run('list-skills', 'documentation'));
if (!/^\d+\. personal\/notes {2}\[personal, ok\]$/m.test(out)) fail(`list-skills should list personal/notes as personal, ok\n${out}`);
if (!out.includes(`path: ${path.join(personalDir, 'notes/SKILL.md')}`)) fail(`personal path should resolve against personal_path\n${out}`);
{
  const r = run('validate-catalog');
  if (!r.ok || !/catalog OK \(\d+ skills \+ 1 personal,/.test(r.out)) fail(`valid personal catalog should validate\n${r.out}`);
  // The shipped example validates once its skill exists.
  fs.mkdirSync(path.join(personalDir, 'release-notes'));
  fs.writeFileSync(path.join(personalDir, 'release-notes/SKILL.md'), '# release-notes\n');
  fs.copyFileSync(path.join(ROOT, 'config/personal-skills.example.yaml'), personalFile);
  const example = run('validate-catalog');
  if (!example.ok) fail(`config/personal-skills.example.yaml should validate\n${example.out}`);
}
withPersonal(personalSkill(), `  personal_path: ${personalDir}\n  documentation:\n    prefer: [personal/notes]\n  exclude: [personal/notes]\n`);
if (!run('validate-catalog').ok) fail('preferences should accept personal ids');
({ out } = run('list-skills', 'documentation'));
if (!/^1\. personal\/notes {2}\[preference, excluded\]$/m.test(out)) fail(`exclude should mark a personal skill\n${out}`);
withPersonal(personalSkill(), `  personal_path: ${personalDir}\n  documentation:\n    prefer: [personal/notes]\n`);
({ out } = run('list-skills', 'documentation'));
if (!/^1\. personal\/notes {2}\[preference, ok\]$/m.test(out)) fail(`a preferred personal skill should rank first\n${out}`);
// A personal skill named like a cataloged vendor skill is skipped, never a stand-in for it.
withPersonal(personalSkill({ id: 'personal/tdd', cats: '[testing]' }));
if (run('list-skills', 'testing').out.includes('personal/tdd')) fail('list-skills should skip a personal skill named like a vendor skill');
{
  const r = run('validate-catalog');
  const msg = 'warning: config/personal-skills.yaml: personal/tdd: skipped, same name as mattpocock/tdd';
  if (!r.ok || !r.out.includes(msg)) fail(`validate-catalog, expected: ${msg}\ngot:\n${r.out}`);
  if (!/catalog OK \(\d+ skills \+ 0 personal,/.test(r.out)) fail(`the OK line should not count a skipped personal skill\n${r.out}`);
}
for (const key of ['testing:\n    prefer', 'exclude']) {
  withPersonal(personalSkill({ id: 'personal/tdd', cats: '[testing]' }), `  personal_path: ${personalDir}\n  ${key}: [personal/tdd]\n`);
  const r = run('validate-catalog');
  const msg = `error: preferences.${key.split(':')[0]}: personal/tdd is skipped, same name as mattpocock/tdd`;
  if (r.ok || !r.out.includes(msg)) fail(`validate-catalog, expected: ${msg}\ngot:\n${r.out}`);
}
for (const [skill, msg, prefs] of [
  [{ skillPath: 'nope/SKILL.md' }, 'config/personal-skills.yaml: personal/notes: path not found nope/SKILL.md'],
  [{ skillPath: outsideSkill }, `config/personal-skills.yaml: personal/notes: path outside personal_path: ${outsideSkill}`],
  [{ skillPath: '../outside/SKILL.md' }, 'config/personal-skills.yaml: personal/notes: path outside personal_path: ../outside/SKILL.md'],
  [{ cats: '[not-a-category]' }, "config/personal-skills.yaml: personal/notes: invalid category 'not-a-category'"],
  [{ cats: '[framework-review]' }, "config/personal-skills.yaml: personal/notes: only project skills may fill 'framework-review'"],
  [{ id: 'acme/notes' }, "config/personal-skills.yaml: acme/notes: id must start with 'personal/'"],
  [{ extra: '    complexity: [huge]\n' }, "config/personal-skills.yaml: personal/notes: invalid complexity 'huge'"],
  [{ extra: '    invokes: [nobody/nothing]\n' }, 'config/personal-skills.yaml: personal/notes: invokes unknown skill nobody/nothing'],
  [[{}, {}], 'config/personal-skills.yaml: duplicate skill id: personal/notes'],
  [{}, 'config/personal-skills.yaml: needs preferences.personal_path', '  update_check_days: 0\n'],
  [{}, `preferences.personal_path: not a directory: ${outsideSkill}`, `  personal_path: ${outsideSkill}\n`],
]) {
  withPersonal([skill].flat().map(personalSkill).join(''), prefs);
  const r = run('validate-catalog');
  if (r.ok || !r.out.includes(`error: ${msg}`)) fail(`validate-catalog, expected: ${msg}\ngot:\n${r.out}`);
}
withPersonal(personalSkill({ skillPath: '../outside/SKILL.md' }));
({ out } = run('list-skills', 'documentation'));
if (!/^\d+\. personal\/notes {2}\[personal, missing\]$/m.test(out)) fail(`list-skills should list an outside personal path as missing\n${out}`);
// A leading ~ in personal_path expands to the home dir.
withPersonal(personalSkill(), '  personal_path: ~/personal\n');
if (!spawnSync(path.join(tmp, 'scripts/list-skills'), ['documentation'], { encoding: 'utf8', env: { ...process.env, HOME: tmp } })
  .stdout.includes(`path: ${path.join(personalDir, 'notes/SKILL.md')}`)) fail('personal_path should expand a leading ~');
fs.rmSync(personalFile);
fs.rmSync(prefsFile);
// personal_path alone, without config/personal-skills.yaml, changes nothing.
{
  const before = [run('list-skills').out, run('validate-catalog').out];
  fs.writeFileSync(prefsFile, `preferences:\n  personal_path: ${personalDir}\n`);
  if (run('list-skills').out !== before[0] || run('validate-catalog').out !== before[1])
    fail('personal_path without a personal catalog should change nothing');
}
fs.rmSync(prefsFile);

// Configuration discovery: user configuration outside the checkout survives a package update.
// A disposable managed checkout, a separate user-configuration root (both with spaces) and a
// fixture personal skill; behavior is observed through the scripts before and after the update.
{
  const managed = path.join(tmp, 'managed checkout');
  // What a package update leaves: a fresh checkout, ignored files (config/*.yaml) cleaned.
  const install = () => {
    fs.rmSync(managed, { recursive: true, force: true });
    for (const dir of ['catalog', 'scripts', 'skills']) fs.cpSync(path.join(ROOT, dir), path.join(managed, dir), { recursive: true });
    fs.mkdirSync(path.join(managed, 'config'));
    for (const dir of ['vendors', 'node_modules']) fs.symlinkSync(path.join(ROOT, dir), path.join(managed, dir));
  };
  const runIn = (script, args = [], extra = {}) => {
    const r = spawnSync(path.join(managed, 'scripts', script), args, { encoding: 'utf8', env: { ...process.env, ...extra } });
    return { ok: r.status === 0, out: r.stdout + r.stderr };
  };
  const xdg = path.join(tmp, 'user config root');
  const external = path.join(xdg, 'engineering-skills-router');
  const emptyRoot = { XDG_CONFIG_HOME: path.join(tmp, 'empty root') };
  const skillsHome = path.join(fs.realpathSync(tmp), 'my skills');
  fs.mkdirSync(path.join(skillsHome, 'notes'), { recursive: true });
  fs.writeFileSync(path.join(skillsHome, 'notes/SKILL.md'), '---\ndescription: Fixture notes skill.\n---\n# notes\n');
  const personalYaml = 'skills:\n  personal/notes:\n    path: notes/SKILL.md\n    categories: [documentation]\n    use_when:\n      - the task fits\n';
  const prefsYaml = (personalPath) => `preferences:\n  personal_path: ${personalPath}\n  documentation:\n    prefer: [personal/notes]\n`
    + '  exclude: [mattpocock/code-review]\n  implementation:\n    model: openai\n  context_threshold: 123456\n';
  const target = fs.mkdtempSync(path.join(tmp, 'config-target-'));
  fs.mkdirSync(path.join(target, '.router'));
  fs.writeFileSync(path.join(target, '.router/state.json'),
    fs.readFileSync(path.join(ROOT, STATE_MD), 'utf8').match(/```json\n([\s\S]*?)```/)[1]);
  // The effective behavior a user sees: selected and excluded skills, a step's model, the threshold.
  const behavior = (extra) => {
    const docs = runIn('list-skills', ['documentation'], extra).out;
    const review = runIn('list-skills', ['review'], extra).out;
    return [
      docs.match(/^1\. .*$/m)?.[0], docs.match(/^ {3}path: .*notes.*$/m)?.[0],
      review.match(/^\d+\. mattpocock\/code-review {2}.*$/m)?.[0],
      runIn('state', [target, 'model', 'implementation'], extra).out.trim(),
      runIn('context-threshold', [], extra).out.trim(),
    ].join('\n');
  };
  const expected = ['1. personal/notes  [preference, ok]', `   path: ${path.join(skillsHome, 'notes/SKILL.md')}`,
    '1. mattpocock/code-review  [vendor, excluded]', 'openai-codex/gpt-6-sol', '123456'].join('\n');

  // External configuration (the XDG default) applies, and survives replacement and cleanup.
  install();
  fs.mkdirSync(external, { recursive: true });
  fs.writeFileSync(path.join(external, 'preferences.yaml'), prefsYaml(skillsHome));
  fs.writeFileSync(path.join(external, 'personal-skills.yaml'), personalYaml);
  const xdgEnv = { XDG_CONFIG_HOME: xdg };
  if (behavior(xdgEnv) !== expected) fail(`external configuration should apply\n${behavior(xdgEnv)}`);
  {
    const r = runIn('validate-catalog', [], xdgEnv);
    if (!r.ok || !/catalog OK \(\d+ skills \+ 1 personal,/.test(r.out)) fail(`external configuration should validate\n${r.out}`);
    const shown = runIn('config', [], xdgEnv);
    if (!shown.ok || !shown.out.includes('source: external') || !shown.out.includes(`preferences: ${path.join(external, 'preferences.yaml')}`))
      fail(`scripts/config should report the external source\n${shown.out}`);
  }
  const before = fs.readFileSync(path.join(external, 'preferences.yaml'), 'utf8');
  install();
  if (behavior(xdgEnv) !== expected) fail(`behavior should survive a checkout update\n${behavior(xdgEnv)}`);
  if (fs.readFileSync(path.join(external, 'preferences.yaml'), 'utf8') !== before) fail('the update should leave external files unchanged');
  if (!runIn('validate-catalog', [], xdgEnv).ok) fail('external configuration should validate after the update');

  // No configuration anywhere: documented defaults, reported as such.
  {
    const b = behavior(emptyRoot);
    if (b.includes('personal/notes') || b.includes('excluded') || !b.endsWith('claude-bridge/claude-opus-5-5\n150000'))
      fail(`missing configuration should give the defaults\n${b}`);
    if (!runIn('config', [], emptyRoot).out.includes('source: defaults')) fail('scripts/config should report defaults');
  }

  // An explicit location wins over the XDG default, with a path containing spaces.
  {
    const chosen = path.join(tmp, 'chosen config');
    fs.cpSync(external, chosen, { recursive: true });
    const env = { ...emptyRoot, ENGINEERING_ROUTER_CONFIG: chosen };
    if (behavior(env) !== expected) fail(`explicit configuration should apply\n${behavior(env)}`);
    if (!runIn('config', [], env).out.includes('source: explicit')) fail('scripts/config should report the explicit source');
    const missing = runIn('validate-catalog', [], { ENGINEERING_ROUTER_CONFIG: path.join(tmp, 'nowhere') });
    if (missing.ok || !missing.out.includes('ENGINEERING_ROUTER_CONFIG: not a directory')) fail(`a missing explicit directory should fail\n${missing.out}`);
  }

  // Malformed configuration is diagnosed, not read as absent.
  for (const [file, text, msg] of [
    ['preferences.yaml', 'preferences: [unclosed\n', 'malformed YAML'],
    ['preferences.yaml', 'review:\n  prefer: [mattpocock/tdd]\n', "expected a top-level 'preferences:' mapping"],
    ['personal-skills.yaml', 'skills: {\n', 'malformed YAML'],
  ]) {
    const dir = fs.mkdtempSync(path.join(tmp, 'bad config '));
    fs.writeFileSync(path.join(dir, file), text);
    const r = runIn('validate-catalog', [], { ENGINEERING_ROUTER_CONFIG: dir });
    if (r.ok || !r.out.includes(`error: ${path.join(dir, file)}: ${msg}`)) fail(`expected: ${file}: ${msg}\n${r.out}`);
  }

  // Clone-local configuration still works on its own; a relative personal_path keeps the checkout as its base.
  const cloneFiles = ['preferences.yaml', 'personal-skills.yaml'].map((f) => path.join(managed, 'config', f));
  const cloneLocal = () => {
    install();
    fs.writeFileSync(cloneFiles[0], prefsYaml('../my skills'));
    fs.writeFileSync(cloneFiles[1], personalYaml);
  };
  cloneLocal();
  if (behavior(emptyRoot) !== expected) fail(`clone-local configuration should apply\n${behavior(emptyRoot)}`);
  if (!runIn('config', [], emptyRoot).out.includes('source: clone-local')) fail('scripts/config should report the clone-local source');

  // Both present: the external one is used, never merged, and validation names the collision.
  {
    const r = runIn('validate-catalog', [], xdgEnv);
    if (r.ok || !r.out.includes('error: config/preferences.yaml: ignored, the external configuration')) fail(`a collision should fail validation\n${r.out}`);
    if (behavior(xdgEnv) !== expected) fail(`the external configuration should win a collision\n${behavior(xdgEnv)}`);
  }

  // Transition: migrate shows the plan, refuses to overwrite, validates, and keeps the originals on failure.
  const snapshot = (dir) => (fs.existsSync(dir) ? fs.readdirSync(dir).sort().map((f) => `${f}:${fs.readFileSync(path.join(dir, f), 'utf8')}`).join('|') : 'absent');
  const fresh = (name) => {
    const root = path.join(tmp, name);
    return { env: { XDG_CONFIG_HOME: root }, dest: path.join(root, 'engineering-skills-router') };
  };
  {
    const { env, dest } = fresh('plan root');
    const original = snapshot(path.join(managed, 'config'));
    const plan = runIn('config', ['migrate'], env);
    if (!plan.ok || !plan.out.includes(`${cloneFiles[0]}\n    -> ${path.join(dest, 'preferences.yaml')}`)
      || !plan.out.includes(`personal_path ../my skills becomes ${skillsHome}`) || !plan.out.includes('Nothing changed'))
      fail(`migrate should show the concrete movement\n${plan.out}`);
    if (snapshot(path.join(managed, 'config')) !== original || fs.existsSync(dest)) fail('migrate without --yes should change nothing');

    const taken = runIn('config', ['migrate', '--yes'], xdgEnv);
    const externalBefore = snapshot(external);
    if (taken.ok || !taken.out.includes('already exist') || snapshot(external) !== externalBefore || snapshot(path.join(managed, 'config')) !== original)
      fail(`migrate should refuse an existing destination and change nothing\n${taken.out}`);

    fs.writeFileSync(cloneFiles[0], `${prefsYaml('../my skills')}  review:\n    prefer: [nobody/nothing]\n`);
    const invalid = snapshot(path.join(managed, 'config'));
    const bad = runIn('config', ['migrate', '--yes'], env);
    if (bad.ok || !bad.out.includes('does not validate') || snapshot(path.join(managed, 'config')) !== invalid || snapshot(dest) !== 'absent')
      fail(`a configuration that does not validate should not move\n${bad.out}\n${snapshot(dest)}`);
  }
  {
    // Success: the files move, the relative personal_path keeps pointing at the same skills, and the
    // behavior survives the next update.
    cloneLocal();
    const { env, dest } = fresh('migrated root');
    const done = runIn('config', ['migrate', '--yes'], env);
    if (!done.ok || !done.out.includes(`In effect now: ${dest}`)) fail(`migrate --yes should succeed\n${done.out}`);
    if (cloneFiles.some((f) => fs.existsSync(f))) fail('migrate --yes should remove the clone-local originals once done');
    if (!fs.readFileSync(path.join(dest, 'preferences.yaml'), 'utf8').includes(`personal_path: ${JSON.stringify(skillsHome)}\n`)) fail(`personal_path should keep its meaning\n${fs.readFileSync(path.join(dest, 'preferences.yaml'), 'utf8')}`);
    if (fs.readFileSync(path.join(dest, 'personal-skills.yaml'), 'utf8') !== personalYaml) fail('the personal catalog should move unchanged');
    if (behavior(env) !== expected) fail(`behavior should be unchanged after migration\n${behavior(env)}`);
    install();
    if (behavior(env) !== expected || !runIn('validate-catalog', [], env).ok) fail(`behavior should survive an update after migration\n${behavior(env)}`);
  }
  {
    // An explicit location is the migration's destination.
    cloneLocal();
    const chosen = path.join(tmp, 'explicit dest');
    const env = { ...emptyRoot, ENGINEERING_ROUTER_CONFIG: chosen };
    const done = runIn('config', ['migrate', '--yes'], env);
    if (!done.ok || !fs.existsSync(path.join(chosen, 'personal-skills.yaml')) || behavior(env) !== expected) fail(`migrate should honor ${'ENGINEERING_ROUTER_CONFIG'}\n${done.out}`);
  }
}

// Source-backed descriptions: a scratch vendor checkout (a git repo) registered as source `acme`.
// Descriptions come from each SKILL.md frontmatter at the checked-out revision, never the catalog.
const acmeDir = path.join(tmp, 'fixtures/acme');
const acmeSkill = (name, text) => {
  fs.mkdirSync(path.join(acmeDir, 'skills', name), { recursive: true });
  fs.writeFileSync(path.join(acmeDir, 'skills', name, 'SKILL.md'), text);
};
// Without the GIT_* variables a pre-commit hook exports, which would aim these at the router repo.
const gitEnv = Object.fromEntries(Object.entries(process.env).filter(([k]) => !k.startsWith('GIT_')));
const git = (...a) => spawnSync('git', ['-C', acmeDir, '-c', 'user.name=t', '-c', 'user.email=t@t', ...a], { encoding: 'utf8', env: gitEnv });
acmeSkill('one', '---\nname: one\ndescription: Reviews a diff | flags <risky> changes & more.\n---\n# one\n');
acmeSkill('folded', '---\nname: folded\ndescription: >\n  Folded text\n  across   lines.\n---\n');
acmeSkill('plain', '---\nname: plain\ndescription: Plain scalar\n  continued on the next line.\n---\n');
acmeSkill('nodesc', '---\nname: nodesc\n---\n# no description\n');
acmeSkill('broken', '---\nname: [broken\ndescription: x\n---\n');
acmeSkill('nofm', '# no frontmatter\n');
git('init', '-q');
git('add', '.');
git('commit', '-qm', 'fixture');
const acmeRev = git('rev-parse', 'HEAD').stdout.trim();
const sourcesFile = path.join(tmp, 'catalog/sources.yaml');
const sourcesText = fs.readFileSync(sourcesFile, 'utf8');
const catalogSkillsFile = path.join(tmp, 'catalog/skills.yaml');
const catalogSkillsText = fs.readFileSync(catalogSkillsFile, 'utf8');
fs.writeFileSync(sourcesFile, `${sourcesText}
  acme:
    repository: https://github.com/acme/skills
    local_path: fixtures/acme
    skill_globs:
      - skills/*/SKILL.md
`);
fs.writeFileSync(catalogSkillsFile, `${catalogSkillsText}
${['one', 'folded', 'plain', 'nodesc', 'broken', 'nofm'].map((n) => `  acme/${n}:
    source: acme
    path: fixtures/acme/skills/${n}/SKILL.md
    categories: [review]
    use_when:
      - router-owned signal for ${n}
`).join('\n')}`);
{
  const r = run('validate-catalog');
  if (!r.ok) fail(`a source with missing descriptions should still validate\n${r.out}`);
  for (const [id, reason] of [['acme/nodesc', 'missing description'], ['acme/broken', 'malformed frontmatter'], ['acme/nofm', 'no frontmatter']]) {
    if (!r.out.includes(`warning: ${id}: description unavailable: ${reason}`)) fail(`validate-catalog should warn: ${id} ${reason}\n${r.out}`);
  }
  ({ out } = run('list-skills', 'review'));
  const descriptionOf = (id) => out.split(/^\d+\. /m).find((b) => b.startsWith(`${id}  `))?.match(/^ {3}description: (.*)$/m)?.[1];
  for (const [id, want] of [
    ['acme/one', 'Reviews a diff | flags <risky> changes & more.'],
    ['acme/folded', 'Folded text across lines.'],
    ['acme/plain', 'Plain scalar continued on the next line.'],
    ['acme/nodesc', '(unavailable: missing description)'],
    ['acme/nofm', '(unavailable: no frontmatter)'],
  ]) {
    if (descriptionOf(id) !== want) fail(`list-skills ${id}: expected description ${want}; got ${descriptionOf(id)}\n${out}`);
  }
  if (!/^\(unavailable: malformed frontmatter: /.test(descriptionOf('acme/broken') ?? '')) fail(`list-skills acme/broken: expected malformed diagnostic\n${out}`);
  if (!/use_when: router-owned signal for one$/m.test(out)) fail('router metadata should stay alongside the source description');
  // Changing only the source changes the next listing; the catalog is untouched.
  acmeSkill('one', '---\nname: one\ndescription: Rewritten upstream.\n---\n');
  ({ out } = run('list-skills', 'review'));
  if (descriptionOf('acme/one') !== 'Rewritten upstream.') fail(`list-skills should follow the source description\n${out}`);
  if (fs.readFileSync(catalogSkillsFile, 'utf8').includes('Rewritten')) fail('the catalog should not receive source text');
  acmeSkill('one', '---\nname: one\ndescription: Reviews a diff | flags <risky> changes & more.\n---\n# one\n');
}

// Guides: a registry separate from executable skills, with validated source ownership.
{
  ({ out } = run('list-skills', '--guides'));
  for (const [id, text] of [
    ['mattpocock/ask-matt', 'Ask which skill or flow fits your situation.'],
    ['pstack/poteto-help', 'Guides users through pstack setup'],
    ['addyosmani/using-agent-skills', 'Discovers and invokes agent skills.'],
  ]) {
    if (!new RegExp(`^\\d+\\. ${id}\\n {3}path: \\S+\\n {3}description: ${text}`, 'm').test(out)) fail(`list-skills --guides should list ${id} with its source description\n${out}`);
  }
  const allPhases = run('list-skills').out;
  if (/ask-matt|poteto-help|using-agent-skills/.test(allPhases)) fail(`guides should never be phase candidates\n${allPhases}`);
  if (!/^workflow-selection +pstack\/poteto-mode$/m.test(allPhases)) fail(`poteto-mode should stay an executable orchestrator\n${allPhases}`);

  const guidesFile = path.join(tmp, 'catalog/guides.yaml');
  const guidesText = fs.readFileSync(guidesFile, 'utf8');
  const guide = (id, source, guidePath) => `  ${id}:\n    source: ${source}\n    path: ${guidePath}\n`;
  fs.writeFileSync(guidesFile, `${guidesText}${guide('acme/nodesc', 'acme', 'fixtures/acme/skills/nodesc/SKILL.md')}`);
  // A guide cannot also be a cataloged executable skill: acme/nodesc is one in this scratch catalog.
  let r = run('validate-catalog');
  if (r.ok || !r.out.includes('error: guides: acme/nodesc: also cataloged as an executable skill')) fail(`validate-catalog should reject a guide that is also a skill\n${r.out}`);
  fs.writeFileSync(guidesFile, `${guidesText}${guide('acme/guide', 'acme', 'fixtures/acme/skills/nodesc/SKILL.md')}`);
  r = run('validate-catalog');
  if (!r.ok || !r.out.includes('warning: guides: acme/guide: description unavailable: missing description')) fail(`a guide without a description should validate with a warning\n${r.out}`);
  ({ out } = run('list-skills', '--guides'));
  if (!/^\d+\. acme\/guide\n {3}path: \S+\n {3}description: \(unavailable: missing description\)$/m.test(out)) fail(`list-skills --guides should show the diagnostic\n${out}`);
  for (const [entry, msg] of [
    [guide('acme/guide', 'nobody', 'fixtures/acme/skills/one/SKILL.md'), "guides: acme/guide: unknown source 'nobody'"],
    [guide('acme/guide', 'pstack', 'vendors/pstack/skills/poteto-help/SKILL.md'), "guides: acme/guide: id must start with 'pstack/'"],
    [guide('acme/guide', 'acme', 'fixtures/acme/skills/none/SKILL.md'), 'guides: acme/guide: path not found fixtures/acme/skills/none/SKILL.md'],
    [guide('acme/guide', 'acme', 'vendors/pstack/skills/poteto-help/SKILL.md'), 'guides: acme/guide: path outside source acme (fixtures/acme): vendors/pstack/skills/poteto-help/SKILL.md'],
    [guide('acme/guide', 'acme', 'fixtures/acme/../acme/skills/one/SKILL.md'), null],
  ]) {
    fs.writeFileSync(guidesFile, `${guidesText}${entry}`);
    r = run('validate-catalog');
    if (msg === null ? !r.ok : (r.ok || !r.out.includes(`error: ${msg}`))) fail(`validate-catalog guides, expected: ${msg ?? 'OK'}\ngot:\n${r.out}`);
  }
  fs.writeFileSync(guidesFile, guidesText);
  // A preference cannot turn a guide into a phase candidate.
  fs.writeFileSync(prefsFile, 'preferences:\n  workflow-selection:\n    prefer: [mattpocock/ask-matt]\n');
  r = run('validate-catalog');
  if (r.ok || !r.out.includes('error: preferences.workflow-selection: unknown skill mattpocock/ask-matt')) fail(`a preference should not name a guide\n${r.out}`);
  fs.rmSync(prefsFile);
}

// The skill index is generated from the guide registry, the catalog and the vendor checkouts,
// with the same descriptions as list-skills and links pinned to the checked-out revisions.
{
  const indexFile = path.join(tmp, 'docs/skill-index.md');
  let r = run('skill-index');
  if (!r.ok) fail(`skill-index should write the index\n${r.out}`);
  if (!r.out.includes('warning: acme/nodesc: description unavailable: missing description')) fail(`skill-index should report an unreadable description\n${r.out}`);
  const index = fs.readFileSync(indexFile, 'utf8');
  const section = (title) => index.split(/^## /m).find((s) => s.startsWith(`${title}\n`)) ?? '';
  if (!index.includes('[Back to the README](../README.md)')) fail('the index should link back to the README');
  const oneLink = `[acme/one](https://github.com/acme/skills/blob/${acmeRev}/skills/one/SKILL.md)`;
  const reviewRow = `| ${oneLink} | Reviews a diff \\| flags &lt;risky&gt; changes &amp; more. | — |`;
  if (!section('Workflow and supporting skills').includes(`### Review\n`) || !index.includes(reviewRow)) fail(`index should list acme/one under Review, escaped and pinned\n${reviewRow}`);
  ({ out } = run('list-skills', 'review'));
  const folded = out.match(/^\d+\. acme\/folded .*\n(?: {3}.*\n)*? {3}description: (.*)$/m)[1];
  if (!index.includes(`/skills/folded/SKILL.md) | ${folded} |`)) fail('index and list-skills should share one description');
  if (!index.includes('/skills/nodesc/SKILL.md) | _(description unavailable: missing description)_ |')) fail('index should show the diagnostic, not invented text');
  if (!/\[mattpocock\/ask-matt\]\(https:\/\/github\.com\/mattpocock\/skills\/blob\/[0-9a-f]{40}\/skills\/engineering\/ask-matt\/SKILL\.md\) \| Ask which skill/.test(section('Guides')))
    fail('Guides should list ask-matt with its pinned link and source description');
  if (!section('Orchestrators').includes('[pstack/poteto-mode]') || section('Guides').includes('[pstack/poteto-mode]')) fail('poteto-mode should be an orchestrator, not a guide');
  if (!section('Principles').includes('[pstack/principle-prove-it-works]') || section('Workflow and supporting skills').includes('principle-'))
    fail('principles should have their own section');
  if (!run('skill-index', '--check').ok) fail('a fresh index should pass --check');
  acmeSkill('one', '---\nname: one\ndescription: Rewritten upstream.\n---\n');
  r = run('skill-index', '--check');
  if (r.ok || !r.out.includes('docs/skill-index.md is stale')) fail(`--check should report a stale index\n${r.out}`);
  if (fs.readFileSync(indexFile, 'utf8') !== index) fail('--check should not write');
  acmeSkill('one', '---\nname: one\ndescription: Reviews a diff | flags <risky> changes & more.\n---\n# one\n');
}
// `list-skills` lists candidates on equal standing (`--neutral` is the same listing). Explicit
// choices keep their origin; vendor entries never get a preferred or fallback tier, and neither
// catalog order nor a legacy rankings file changes the listing.
{
  const neutral = (...phases) => run('list-skills', '--neutral', ...phases).out;
  const rankingsFile = path.join(tmp, 'catalog/rankings.yaml');
  if (fs.existsSync(rankingsFile)) fail('catalog/rankings.yaml is retired and should not ship');
  if (neutral('review') !== run('list-skills', 'review').out) fail('list-skills and list-skills --neutral should print the same listing');
  const before = neutral('review', 'implementation');
  if (/\[(preferred|fallback|other),/.test(before)) fail(`--neutral should not show ranking tiers\n${before}`);
  for (const id of ['mattpocock/code-review', 'addyosmani/code-review-and-quality', 'pstack/interrogate', 'pstack/arena', 'mattpocock/implement']) {
    if (!new RegExp(`^\\d+\\. ${id} {2}\\[vendor, ok\\]$`, 'm').test(before)) fail(`--neutral should list ${id} as vendor, ok\n${before}`);
  }
  // Shuffled catalog order and changed legacy rankings leave the listing unchanged.
  const current = fs.readFileSync(catalogSkillsFile, 'utf8');
  const shuffled = current.split('\n\n');
  const head = shuffled.indexOf('skills:') + 1;
  fs.writeFileSync(catalogSkillsFile, [...shuffled.slice(0, head), ...shuffled.slice(head).reverse()].join('\n\n'));
  fs.writeFileSync(rankingsFile, 'rankings:\n  review:\n    preferred: [pstack/interrogate]\n'
    + '  implementation:\n    preferred: [addyosmani/incremental-implementation]\n    fallback: [nobody/nothing]\n');
  const legacy = run('validate-catalog');
  if (!legacy.ok || !legacy.out.includes('warning: catalog/rankings.yaml: no longer read; candidates stand on equal terms'))
    fail(`validate-catalog should only warn about a legacy rankings file\n${legacy.out}`);
  const after = neutral('review', 'implementation');
  if (after !== before)
    fail(`--neutral should not depend on catalog order or rankings\nbefore:\n${before}\nafter:\n${after}`);
  fs.writeFileSync(catalogSkillsFile, current);
  fs.rmSync(rankingsFile);
  // Explicit choices stay effective: a suitable preference is labeled, an exclusion still bars.
  fs.writeFileSync(prefsFile, 'preferences:\n  review:\n    prefer: [pstack/interrogate]\n  exclude: [mattpocock/code-review]\n');
  out = neutral('review');
  if (!/^1\. pstack\/interrogate {2}\[preference, ok\]$/m.test(out)) fail(`--neutral should keep an explicit preference\n${out}`);
  if (!/^\d+\. mattpocock\/code-review {2}\[vendor, excluded\]$/m.test(out)) fail(`--neutral should keep an exclusion\n${out}`);

  // check-selection: every reference in a selector proposal must be usable for its phase.
  const repo = targetRepo(projectSkill());
  const selectionFile = path.join(tmp, 'selection.md');
  const pick = (skill, reason = 'fits this task') => ({ skill, reason });
  const proposal = (phases, extra = {}) => ({ phases, missing: [], ...extra });
  const check = (sel, ...args) => {
    fs.writeFileSync(selectionFile, `# Proposal\n\nSome prose.\n\n\`\`\`json\n${JSON.stringify(sel, null, 2)}\n\`\`\`\n`);
    return run('check-selection', '--target', repo, ...args, selectionFile);
  };
  const good = proposal([
    { phase: 'review', reason: 'the change needs a review', default: pick('pstack/interrogate'), alternatives: [pick('addyosmani/code-review-and-quality')] },
    { phase: 'framework-review', reason: 'the repo has its own practices', default: pick('project/fw'), alternatives: [] },
    { phase: 'implementation', reason: 'code must change', default: pick('mattpocock/implement'),
      alternatives: [pick('addyosmani/incremental-implementation'), pick('pstack/arena', 'High cost: competing designs')] },
  ], { missing: [{ phase: 'release', reason: 'no shipping skill fits' }] });
  let r = check(good);
  if (!r.ok || !r.out.includes('selection OK')) fail(`a usable selection should pass check-selection\n${r.out}`);
  const mutate = (fn) => { const s = JSON.parse(JSON.stringify(good)); fn(s); return s; };
  for (const [sel, msg] of [
    [mutate((s) => { s.phases[0].default.skill = 'nobody/nothing'; }), 'review: default nobody/nothing: unknown skill'],
    [mutate((s) => { s.phases[0].default.skill = 'mattpocock/ask-matt'; }), 'review: default mattpocock/ask-matt: a guide, not an executable skill'],
    [mutate((s) => { s.phases[0].default.skill = 'mattpocock/code-review'; }), 'review: default mattpocock/code-review: excluded'],
    [mutate((s) => { s.phases[0].alternatives[0].skill = 'mattpocock/tdd'; }), 'review: alternative mattpocock/tdd: not a candidate for this phase'],
    [mutate((s) => { s.phases[1].default.skill = 'addyosmani/code-review-and-quality'; }), 'framework-review: default addyosmani/code-review-and-quality: not a candidate for this phase'],
    [mutate((s) => { s.phases[2].alternatives.push(pick('pstack/swarm')); }), 'implementation: at most two alternatives'],
    [mutate((s) => { s.phases[2].alternatives[0].skill = 'mattpocock/implement'; }), 'implementation: alternative mattpocock/implement: repeats another pick'],
    [mutate((s) => { s.phases[0].default.reason = ' '; }), 'review: default pstack/interrogate: needs a reason'],
    [mutate((s) => { delete s.phases[0].reason; }), 'review: needs a reason'],
    [mutate((s) => { s.phases[0].phase = 'nonsense'; }), "nonsense: unknown phase"],
    [mutate((s) => { delete s.phases[0].default; }), 'review: needs a default (or list the phase under missing)'],
    [mutate((s) => { s.missing.push({ phase: 'review', reason: 'x' }); }), 'review: both selected and missing'],
    [mutate((s) => { s.missing[0].reason = ''; }), 'missing release: needs a reason'],
  ]) {
    r = check(sel);
    if (r.ok || !r.out.includes(`error: ${msg}`)) fail(`check-selection, expected: ${msg}\ngot:\n${r.out}`);
  }
  // Without the target, its project skills are unknown.
  fs.writeFileSync(selectionFile, JSON.stringify(good));
  r = run('check-selection', selectionFile);
  if (r.ok || !r.out.includes('error: framework-review: default project/fw: unknown skill')) fail(`check-selection without --target should not know project skills\n${r.out}`);
  if (run('check-selection', path.join(tmp, 'none.json')).ok) fail('check-selection should fail on a missing file');
  // The selector's commands leave the target repo untouched: no workflow state, no changes.
  const targetGit = (...a) => spawnSync('git', ['-C', repo, '-c', 'user.name=t', '-c', 'user.email=t@t', ...a], { encoding: 'utf8', env: gitEnv });
  targetGit('init', '-q'); targetGit('add', '.'); targetGit('commit', '-qm', 'target');
  const targetHead = targetGit('rev-parse', 'HEAD').stdout;
  check(good);
  run('list-skills', '--neutral', '--target', repo, 'review', 'framework-review');
  run('list-skills', '--guides');
  if (targetGit('status', '--porcelain', '--ignored').stdout !== '' || targetGit('rev-parse', 'HEAD').stdout !== targetHead
    || targetGit('branch', '--list').stdout.trim().split('\n').length !== 1 || fs.existsSync(path.join(repo, '.router')))
    fail('the selector commands should leave the target repo unchanged');
  fs.writeFileSync(selectionFile, 'no json here');
  if (run('check-selection', selectionFile).ok) fail('check-selection should fail without a selection');
  fs.rmSync(prefsFile);
}

// The committed index matches the catalog and the checked-out vendor revisions, also under a
// git hook, whose GIT_DIR must not decide which revision is read.
{
  const r = spawnSync(path.join(ROOT, 'scripts/skill-index'), ['--check'], { encoding: 'utf8', env: { ...process.env, GIT_DIR: path.join(tmp, 'no-repo') } });
  if (r.status !== 0) fail(`docs/skill-index.md should be current\n${r.stdout}${r.stderr}`);
}

// Selector evaluation cases (evals/skill-selector/cases.yaml) are judged by running a model; here
// only their references are checked: every skill a case expects to see proposed is an `ok`
// neutral candidate for its phase, and every vendor has a clear-fit case it should win.
{
  const YAML = require(path.join(ROOT, 'node_modules/yaml'));
  const evals = YAML.parse(fs.readFileSync(path.join(ROOT, 'evals/skill-selector/cases.yaml'), 'utf8'));
  for (const key of ['model', 'effort']) if (!evals.evaluation?.[key]) fail(`selector evals should record the evaluation ${key}`);
  const okFor = {};
  const usable = (phase, id) => {
    okFor[phase] ??= run('list-skills', '--neutral', phase).out;
    return new RegExp(`^\\d+\\. ${id.replace('/', '\\/')} {2}\\[vendor, ok\\]$`, 'm').test(okFor[phase]);
  };
  const clearFit = new Set();
  for (const c of evals.cases ?? []) {
    if (!c.id || !c.task || !Array.isArray(c.expect) || c.expect.length === 0) fail(`selector eval case needs id, task and expect: ${c.id}`);
    for (const e of c.expect) {
      for (const id of [...(e.default_any_of ?? []), ...(e.proposed_any_of ?? [])]) {
        if (!usable(e.phase, id)) fail(`selector eval ${c.id}: ${id} is not an ok candidate for ${e.phase}`);
      }
      if (c.clear_fit && e.default_any_of) e.default_any_of.forEach((id) => clearFit.add(id.split('/')[0]));
    }
  }
  const vendors = Object.keys(YAML.parse(fs.readFileSync(path.join(ROOT, 'catalog/sources.yaml'), 'utf8')).sources);
  const uncovered = vendors.filter((v) => !clearFit.has(v));
  if (uncovered.length > 0) fail(`selector evals need a clear-fit case for: ${uncovered.join(', ')}`);
}

fs.appendFileSync(path.join(tmp, 'catalog/skills.yaml'), `
  pstack/how:
    source: pstack
    path: vendors/pstack/skills/nope/SKILL.md
    categories: [not-a-category]
`);
({ out } = run('validate-catalog'));
for (const msg of ['duplicate skill id: pstack/how', 'path not found', "invalid category 'not-a-category'"]) {
  if (!out.includes(msg)) fail(`expected: ${msg}`);
}

// Drop the grilling entry: grill-me calls it, so validation must flag the missing skill.
const skillsFile = path.join(tmp, 'catalog/skills.yaml');
const blocks = fs.readFileSync(path.join(ROOT, 'catalog/skills.yaml'), 'utf8').split('\n\n');
fs.writeFileSync(skillsFile, blocks.filter((b) => !b.startsWith('  mattpocock/grilling:')).join('\n\n'));
({ out } = run('validate-catalog'));
if (!out.includes('mattpocock/grill-me: calls uncataloged skill mattpocock/grilling')) fail('expected: calls uncataloged skill');

// Resolver: each case copies the skill folder alone into a scratch dir with a fake HOME and
// a clean env, then checks what root the resolver prints and how it says it found it.
const SKILL_DIR = 'skills/engineering-router';
const PI_REPO = 'git/github.com/marcoax/engineering-skills-router';
const DATA_DIR = '.local/share/engineering-skills-router';
const resolverCase = () => {
  const dir = fs.realpathSync(fs.mkdtempSync(path.join(tmp, 'resolve-')));
  const home = path.join(dir, 'home');
  const lone = path.join(home, '.agents/skills/engineering-router');
  fs.cpSync(path.join(ROOT, SKILL_DIR), lone, { recursive: true });
  // A minimal checkout (catalog/skills.yaml), with the skill folder inside when withSkill is set.
  const checkout = (p, { withSkill = false } = {}) => {
    fs.mkdirSync(path.join(p, 'catalog'), { recursive: true });
    fs.writeFileSync(path.join(p, 'catalog/skills.yaml'), 'skills: {}\n');
    if (withSkill) fs.cpSync(lone, path.join(p, SKILL_DIR), { recursive: true });
    return p;
  };
  const resolve = (env = {}, skillDir = lone) => {
    const r = spawnSync(process.execPath, [path.join(skillDir, 'resolve-root.js')], {
      encoding: 'utf8', env: { PATH: process.env.PATH, HOME: home, ...env },
    });
    return `${r.stdout}${r.stderr}exit ${r.status}`;
  };
  return { dir, home, checkout, resolve };
};
const expectResolve = (label, got, want) => {
  if (got !== want) fail(`resolver, ${label}\nexpected:\n${want}\ngot:\n${got}`);
};
// `skill` is the checkout's own SKILL.md, printed when the resolver runs from a copy outside it.
const resolvedOutput = (root, how, skill) => `root: ${root}\nfound: ${how}\n${skill ? `skill: ${skill}\n` : ''}exit 0`;
const skillOf = (root) => path.join(root, SKILL_DIR, 'SKILL.md');

{
  const c = resolverCase();
  const repo = c.checkout(path.join(c.dir, 'repo'), { withSkill: true });
  const link = path.join(c.home, '.claude/skills/engineering-router');
  fs.mkdirSync(path.dirname(link), { recursive: true });
  fs.symlinkSync(path.join(repo, SKILL_DIR), link);
  expectResolve('linked install', c.resolve({}, link), resolvedOutput(repo, 'skill-dir'));
}
{
  const c = resolverCase();
  expectResolve('nothing found', c.resolve(), `missing\ndata-dir: ${path.join(c.home, DATA_DIR)}\nexit 2`);
}
{
  const c = resolverCase();
  const repo = c.checkout(path.join(c.dir, 'anywhere'));
  expectResolve('ENGINEERING_ROUTER_HOME', c.resolve({ ENGINEERING_ROUTER_HOME: repo }), resolvedOutput(repo, 'env'));
}
{
  const c = resolverCase();
  const repo = c.checkout(path.join(c.home, '.pi/agent', PI_REPO), { withSkill: true });
  expectResolve('Pi checkout', c.resolve(), resolvedOutput(repo, 'pi', skillOf(repo)));
  expectResolve('Pi checkout, native skill', c.resolve({}, path.join(repo, SKILL_DIR)), resolvedOutput(repo, 'pi'));
  expectResolve('Pi checkout, env', c.resolve({ ENGINEERING_ROUTER_HOME: repo }), resolvedOutput(repo, 'pi', skillOf(repo)));
  const link = path.join(c.dir, 'pi-repo-link');
  fs.symlinkSync(repo, link);
  expectResolve('Pi checkout, symlinked env', c.resolve({ ENGINEERING_ROUTER_HOME: link }), resolvedOutput(link, 'pi', skillOf(link)));
  const customAgent = path.join(c.dir, 'pi-agent');
  const custom = c.checkout(path.join(customAgent, PI_REPO), { withSkill: true });
  expectResolve('Pi checkout, PI_CODING_AGENT_DIR',
    c.resolve({ PI_CODING_AGENT_DIR: customAgent }), resolvedOutput(custom, 'pi', skillOf(custom)));
  expectResolve('Pi checkout, native skill with PI_CODING_AGENT_DIR',
    c.resolve({ PI_CODING_AGENT_DIR: customAgent }, path.join(custom, SKILL_DIR)), resolvedOutput(custom, 'pi'));
  const agentLink = path.join(c.dir, 'pi-agent-link');
  fs.symlinkSync(customAgent, agentLink);
  expectResolve('Pi checkout, native skill with symlinked PI_CODING_AGENT_DIR',
    c.resolve({ PI_CODING_AGENT_DIR: agentLink }, path.join(custom, SKILL_DIR)), resolvedOutput(custom, 'pi'));
}
{
  const c = resolverCase();
  const xdg = path.join(c.dir, 'xdg');
  expectResolve('nothing found, XDG_DATA_HOME', c.resolve({ XDG_DATA_HOME: xdg }),
    `missing\ndata-dir: ${xdg}/engineering-skills-router\nexit 2`);
  const repo = c.checkout(path.join(c.home, DATA_DIR));
  expectResolve('data-dir checkout', c.resolve(), resolvedOutput(repo, 'data-dir'));
  const xdgRepo = c.checkout(path.join(xdg, 'engineering-skills-router'));
  expectResolve('data-dir checkout, XDG_DATA_HOME', c.resolve({ XDG_DATA_HOME: xdg }),
    resolvedOutput(xdgRepo, 'data-dir'));
}
{
  const c = resolverCase();
  const data = c.checkout(path.join(c.home, DATA_DIR));
  const pi = c.checkout(path.join(c.home, '.pi/agent', PI_REPO));
  const env = { ENGINEERING_ROUTER_HOME: c.checkout(path.join(c.dir, 'env-repo')) };
  const repo = c.checkout(path.join(c.dir, 'repo'), { withSkill: true });
  expectResolve('precedence, all present', c.resolve(env, path.join(repo, SKILL_DIR)),
    resolvedOutput(repo, 'skill-dir'));
  expectResolve('precedence, env over pi', c.resolve(env), resolvedOutput(env.ENGINEERING_ROUTER_HOME, 'env'));
  expectResolve('precedence, pi over data-dir', c.resolve(), resolvedOutput(pi, 'pi'));
  fs.rmSync(path.join(pi, 'catalog'), { recursive: true });
  fs.rmSync(path.join(env.ENGINEERING_ROUTER_HOME, 'catalog'), { recursive: true });
  expectResolve('candidates without catalog skipped', c.resolve(env), resolvedOutput(data, 'data-dir'));
}

{
  // A lone copy delegates to the checkout's own skill, so the two cannot drift apart.
  // Delegation is path-based, not content-based, so identical copies (as here) still delegate.
  const c = resolverCase();
  const repo = c.checkout(path.join(c.home, DATA_DIR), { withSkill: true });
  const checkoutSkill = skillOf(repo);
  expectResolve('lone copy, checkout with its skill', c.resolve(), resolvedOutput(repo, 'data-dir', checkoutSkill));
  expectResolve('checkout skill it delegates to', c.resolve({}, path.dirname(checkoutSkill)), resolvedOutput(repo, 'skill-dir'));
}
{
  // The selector installed alone finds the same checkout and delegates to its own copy there.
  const c = resolverCase();
  const repo = c.checkout(path.join(c.home, DATA_DIR));
  fs.cpSync(path.join(ROOT, 'skills'), path.join(repo, 'skills'), { recursive: true });
  const lone = path.join(c.home, '.agents/skills/skill-selector');
  fs.cpSync(path.join(ROOT, 'skills/skill-selector'), lone, { recursive: true });
  const selectorSkill = path.join(repo, 'skills/skill-selector/SKILL.md');
  expectResolve('lone selector copy', c.resolve({}, lone), resolvedOutput(repo, 'data-dir', selectorSkill));
  expectResolve('selector in its checkout', c.resolve({}, path.dirname(selectorSkill)), resolvedOutput(repo, 'skill-dir'));}

// check-state: the example in state.md must pass; each broken variant must name its error.
const stateExample = () => JSON.parse(fs.readFileSync(path.join(tmp, STATE_MD), 'utf8').match(/```json\n([\s\S]*?)```/)[1]);
const checkState = (state) => {
  const dir = fs.mkdtempSync(path.join(tmp, 'target-'));
  if (state !== undefined) {
    fs.mkdirSync(path.join(dir, '.router'));
    fs.writeFileSync(path.join(dir, '.router/state.json'), typeof state === 'string' ? state : JSON.stringify(state));
  }
  return run('check-state', dir);
};
const expectStateOk = (label, state) => {
  const r = checkState(state);
  if (!r.ok) fail(`check-state should accept ${label}\n${r.out}`);
};
expectStateOk('the state.md example', stateExample());
// The agent writes the first state from state-brief.md: its example must pass too.
expectStateOk('the state-brief.md example',
  JSON.parse(fs.readFileSync(path.join(tmp, 'skills/engineering-router/state-brief.md'), 'utf8').match(/```json\n([\s\S]*?)```/)[1]));
const expectState = (label, state, ...msgs) => {
  const r = checkState(state);
  const missing = msgs.filter((m) => !r.out.includes(`error: ${m}`));
  if (r.ok || missing.length > 0) fail(`check-state, ${label}: expected\n  error: ${missing.join('\n  error: ')}\ngot:\n${r.out}`);
};
expectState('missing file', undefined, '.router/state.json: not found');
expectState('invalid JSON', '{"version": 1,', 'invalid JSON:');
expectState('other version', { version: 2 }, 'version: unsupported version 2, state.md defines version 1');
if (checkState({ version: 2 }).out.match(/^error:/gm).length !== 1) fail('check-state, other version: should stop at the version');
expectState('no version', { task: 'x' }, 'version: missing');
const variant = (mutate) => { const s = stateExample(); mutate(s); return s; };
expectState('fields and types', variant((s) => {
  delete s.task;
  s.steps[0].confirm = 'yes';
  s.steps[1].phases = 'x';
  s.steps[2].skill = 7;
  s.handoff.issue.number = '42';
  s.handoff.tickets = [{ number: 1 }];
  delete s.handoff.pr;
}),
'task: missing',
'steps[0].confirm: must be boolean, got "yes"',
'steps[1].phases: must be string[], got "x"',
'steps[2].skill: must be string | null, got 7',
'handoff.issue.number: must be integer, got "42"',
'handoff.tickets[0].url: missing',
'handoff.pr: missing');
expectState('enums', variant((s) => { s.risk = 'trivial'; s.status = 'finished'; s.steps[2].status = 'blocked'; }),
  'risk: must be "low" | "medium" | "high", got "trivial"',
  'status: must be one of selecting | running | waiting | done | paused | stopped, got "finished"',
  'steps[2].status: must be one of pending | running | waiting | done | skipped | failed, got "blocked"');
// A low-risk task gets a workflow when the user asks for one anyway.
expectStateOk('a low-risk workflow', variant((s) => { s.risk = 'low'; }));
// complexity was added within version 1: a state written before it still passes.
expectStateOk('a state without complexity', variant((s) => { delete s.complexity; }));
expectState('complexity', variant((s) => { s.complexity = 'tiny'; }),
  'complexity: must be "low" | "medium" | "high", got "tiny"');
// classification was added within version 1: a state written before it still passes.
expectStateOk('a state without classification', variant((s) => { delete s.classification; }));
expectState('classification', variant((s) => { s.classification.facts = [{ fact: 'payment' }]; s.classification.ticket = 'yes'; delete s.classification.rationale.risk; }),
  'classification.facts[0].where: missing', 'classification.facts[0].evidence: missing',
  'classification.ticket: must be boolean, got "yes"', 'classification.rationale.risk: missing');
// primary was added within version 1: a run keeps its own family; absent, it is the preferences'.
expectStateOk('a run with primary claude', variant((s) => { s.primary = 'claude'; }));
expectStateOk('a run with primary openai', variant((s) => { s.primary = 'openai'; }));
expectStateOk('a state without primary', variant((s) => { delete s.primary; }));
expectState('primary', variant((s) => { s.primary = 'gemini'; }), 'primary: must be "claude" | "openai", got "gemini"');
expectState('rules from the prose', variant((s) => {
  s.updated_at = '2026-10-17 09:42';
  s.steps[0].alternatives.push({ skill: 'x', reason: 'r' }, { skill: 'a/b', reason: 'r' });
  s.steps[1].id = 'specification';
  s.steps[1].outcome = null;
  s.steps[2].covered_by = 'nowhere';
  s.steps[2].skill = 'code-review';
  s.steps[2].model = 'claude opus';
}),
'updated_at: must be ISO-8601 UTC (e.g. 2026-10-17T09:42:00Z), got "2026-10-17 09:42"',
'steps[0].alternatives: at most two, got 3',
"steps[0].alternatives[1].skill: must be 'source/name', got \"x\"",
'steps[1].id: duplicate step id "specification"',
'steps[1].outcome: required when status is done',
'steps[2].covered_by: no step with id "nowhere"',
"steps[2].skill: must be 'source/name', got \"code-review\"",
"steps[2].model: must be 'model ID without spaces', got \"claude opus\"");
expectState('impossible date', variant((s) => { s.updated_at = '2026-02-30T09:00:00Z'; }),
  'updated_at: must be ISO-8601 UTC (e.g. 2026-10-17T09:42:00Z), got "2026-02-30T09:00:00Z"');
expectState('alternatives', variant((s) => {
  s.steps[0].alternatives.push({ skill: 'addyosmani/spec-driven-development', reason: 'r' });
  s.steps[1].alternatives.push({ skill: 'a/b', reason: 'r' });
  s.steps[2].alternatives.push({ skill: 'mattpocock/implement', reason: 'r' });
}),
'steps[0].alternatives[1].skill: duplicate alternative "addyosmani/spec-driven-development"',
'steps[1].alternatives: must be empty when skill is null',
'steps[2].alternatives[0].skill: same as the step\'s skill "mattpocock/implement"');
expectState('covered_by', variant((s) => { s.steps[0].covered_by = 'specification'; s.steps[3].covered_by = 'branch'; }),
  'steps[0].covered_by: a step cannot cover itself',
  'steps[3].covered_by: step "branch" has no skill to run it');
{
  const r = checkState(variant((s) => { s.steps[2] = null; }));
  if (r.ok || !r.out.includes('error: steps[2]: must be Step') || /covered_by/.test(r.out))
    fail(`check-state, null step: expected only the type error\ngot:\n${r.out}`);
}
// optional was added within version 1: absent passes (the example), a non-boolean fails.
expectStateOk('optional steps that are off', variant((s) => {
  s.steps[3] = { ...s.steps[3], covered_by: null, optional: true, status: 'skipped', outcome: 'off (optional)' };
}));
expectState('optional', variant((s) => { s.steps[3].optional = 'yes'; }), 'steps[3].optional: must be boolean, got "yes"');
// Between two steps the workflow is still running: one step has ended, the next has not started.
expectStateOk('running between two steps', variant((s) => { s.steps[2].status = 'pending'; }));
expectState('running with no step left', variant((s) => {
  s.steps[2].status = 'done';
  s.steps[2].outcome = 'Built';
  s.steps[3].status = 'skipped';
  s.steps[3].outcome = 'off';
}),
'status: running requires a step with status running or pending');
// The check after implementation is not a step: the next step to run waits instead.
const pullRequest = { id: 'pull-request', phases: ['pull-request'], skill: 'mattpocock/pr', reason: 'r', summary: 's',
  alternatives: [], confirm: true, covered_by: null, model: null, status: 'pending', outcome: null };
expectStateOk('the check after implementation', variant((s) => {
  s.status = 'waiting';
  for (const step of s.steps.slice(2)) Object.assign(step, { status: 'done', outcome: 'Built' });
  s.steps.push({ ...pullRequest, status: 'waiting' });
}));
expectState('waiting with no waiting step', variant((s) => { s.status = 'waiting'; }),
  'status: waiting requires a step with status waiting');
const issueFree = (spec) => variant((s) => { s.handoff.issue = null; s.handoff.spec = spec; s.handoff.branch = 'csv-export'; });
expectStateOk('an issue-free workflow with a spec file', issueFree('docs/specs/csv-export.md'));
// spec was added within version 1, so a state written before it (no spec) still passes.
expectStateOk('a state without handoff.spec', variant((s) => { delete s.handoff.spec; }));
expectState('spec type', issueFree(7), 'handoff.spec: must be string | null, got 7');
expectState('spec outside the repo', issueFree('/tmp/spec.md'),
  'handoff.spec: must be a path relative to the target repo, got "/tmp/spec.md"');
expectState('spec above the repo', issueFree('../spec.md'),
  'handoff.spec: must be a path relative to the target repo, got "../spec.md"');
expectStateOk('a covered step running with its covering step', variant((s) => { s.steps[3].status = 'running'; }));
// The format is read from state.md, so a field added there is required here.
const stateMd = path.join(tmp, STATE_MD);
const stateMdText = fs.readFileSync(stateMd, 'utf8');
fs.writeFileSync(stateMd, stateMdText.replace(/^\| `outcome` .*$/m, '$&\n| `probe` | integer \\| null | Test field. |'));
expectState('field added to state.md', stateExample(), 'steps[0].probe: missing');
fs.writeFileSync(stateMd, stateMdText);
expectStateOk('unknown fields', variant((s) => { s.extra = 1; s.steps[0].extra = {}; s.handoff.issue.extra = null; }));

// Run records: the example in run-record.md parses and adds up as documented.
{
  const { parseRecord, aggregate } = require(path.join(ROOT, 'scripts/lib/runs'));
  const doc = fs.readFileSync(path.join(ROOT, 'skills/engineering-router/run-record.md'), 'utf8');
  const example = doc.match(/```json\n([\s\S]*?)```/)[1];
  const parsed = parseRecord(`Body\n\n<!-- engineering-router:run\n${example}-->\n`);
  if (parsed.kind !== 'ok') fail(`run-record.md example does not parse: ${parsed.kind}`);
  const t = aggregate([parsed.record, parsed.record]);
  const r2 = t.reviewers['review-2 openai-codex/gpt-6-sol:high'];
  const r1 = t.reviewers['review-1 claude-opus-5-5'];
  if (t.paths.full?.runs !== 2 || t.paths.full.serious !== 2 || t.checklist.points !== 18 || t.checklist.failed !== 2 || t.runs !== 2 || r2?.runs !== 2 || r2.found !== 4 || r2.only !== 2 || r2.fixed !== 4 || r1?.declined !== 2 || r1.serious !== 2) {
    fail(`run record totals: ${JSON.stringify(t)}`);
  }
  // A record from before the step model contract (model null on a step that ran) counts
  // toward the same reviewer as one that names the session's model.
  const recordWith = (model, status = 'done') => parseRecord(`<!-- engineering-router:run ${JSON.stringify({
    version: 1, session_model: 'claude-opus-5-5', path: 'full', checklist: null, usage: { tokens: null, cost_usd: null },
    steps: [{ id: 'review-1', skill: 'mattpocock/code-review', model, effort: null, status, tokens: null }],
    findings: [{ title: 'x', severity: 'low', found_by: ['review-1'], decision: 'fixed' }],
  })} -->`).record;
  const mixed = aggregate([recordWith(null), recordWith('claude-opus-5-5')]);
  const same = mixed.reviewers['review-1 claude-opus-5-5'];
  if (Object.keys(mixed.reviewers).length !== 1 || same?.runs !== 2 || same.found !== 2) fail(`old and new records should share a reviewer: ${JSON.stringify(mixed.reviewers)}`);
  // A step that did not run never reads as the session's model.
  const notRun = aggregate([recordWith(null, 'skipped')]).reviewers;
  if (Object.keys(notRun).join() !== 'review-1 unknown') fail(`a step that did not run should not count as session_model: ${JSON.stringify(notRun)}`);
  if (parseRecord('no record').kind !== 'none' || parseRecord('<!-- engineering-router:run {"version":2} -->').kind !== 'version') {
    fail('run records: absent or newer records are not told apart');
  }
}

// setStep: a covered step takes its covering step's step model; one with its own agent record
// keeps it, whichever side of the covering step's close it is recorded on.
{
  const { setStep } = require(path.join(ROOT, 'scripts/lib/state-ops'));
  const started = setStep(variant((s) => { s.steps[3].status = 'waiting'; s.steps[3].model = null; }), 'implementation', 'running', { model: 'claude-opus-5-5', effort: 'medium' });
  if (started.steps[3].model !== 'claude-opus-5-5' || started.steps[3].effort !== 'medium') fail(`a covered step that is open but not pending should take its covering step's model when it starts: ${JSON.stringify(started.steps[3])}`);
  // Own agent record names the model the covering step started on; recorded after the close.
  const covering = setStep(started, 'implementation', 'done', { outcome: 'Built', model: 'claude-sonnet-5-5', effort: 'high' });
  const after = setStep(covering, 'review-1', 'done', { outcome: 'Reviewed', model: 'claude-opus-5-5', effort: 'low' });
  if (after.steps[3].model !== 'claude-opus-5-5' || after.steps[3].effort !== 'low') fail(`a covered step's own agent record, recorded after its covering step closed, should stick: ${JSON.stringify(after.steps[3])}`);
  // Recorded before the close: the closed covered step is left alone.
  const before = setStep(setStep(started, 'review-1', 'done', { outcome: 'Reviewed', model: 'claude-opus-5-5', effort: 'low' }), 'implementation', 'done', { outcome: 'Built', model: 'claude-sonnet-5-5', effort: 'high' });
  if (before.steps[3].model !== 'claude-opus-5-5' || before.steps[3].effort !== 'low') fail(`a covered step closed with its own agent record should keep it when its covering step closes: ${JSON.stringify(before.steps[3])}`);
}

// scripts/state: each change is applied and validated; an invalid one leaves the file as it was.
{
  const repo = fs.mkdtempSync(path.join(tmp, 'state-ops-'));
  fs.mkdirSync(path.join(repo, '.router'));
  const stateFile = path.join(repo, '.router/state.json');
  const read = () => JSON.parse(fs.readFileSync(stateFile, 'utf8'));
  const optional = (id) => ({ id, phases: [], skill: null, reason: 'r', summary: 's', alternatives: [], confirm: false,
    optional: true, covered_by: null, model: null, effort: null, status: 'skipped', outcome: 'off (optional)' });
  const start = variant((s) => {
    s.steps.push(optional('review-2'), optional('comparison'),
      { ...optional('pull-request'), skill: 'mattpocock/pr', optional: false, confirm: true, status: 'pending', outcome: null });
  });
  fs.writeFileSync(stateFile, JSON.stringify(start));
  const st = (...a) => run('state', repo, ...a);
  const expectOk = (label, r) => { if (!r.ok) fail(`scripts/state ${label}\n${r.out}`); };

  // A step that ran records its step model as the source names it, bare IDs included.
  expectOk('step running with a bare model ID', st('step', 'implementation', 'running', '--model', 'claude-opus-5-5'));
  if (read().steps[3].model !== 'claude-opus-5-5') fail(`a covered step should take its covering step's model when it starts: ${JSON.stringify(read().steps[3])}`);
  // Closing from an agent record overwrites the model; the covered step follows it.
  expectOk('step done', st('step', 'implementation', 'done', '--outcome', 'Built', '--model', 'claude-sonnet-5-5', '--effort', 'high'));
  let s = read();
  if (s.steps[3].status !== 'done' || s.steps[3].outcome !== 'ran inside implementation') fail(`a covering step should close its covered step: ${JSON.stringify(s.steps[3])}`);
  if (s.steps[3].model !== 'claude-sonnet-5-5' || s.steps[3].effort !== 'high') fail(`a covered step should take its covering step's model and effort: ${JSON.stringify(s.steps[3])}`);
  // show: a step with a model says what it ran on; a step without one gets nothing extra.
  const shown = st('show').out.split('\n');
  if (!shown.includes('✓ 3. implementation  mattpocock/implement  on claude-sonnet-5-5 · effort high → Built')) fail(`show should print the step model and effort\n${shown.join('\n')}`);
  if (!shown.includes('✓ 4. review-1  mattpocock/code-review inside implementation  on claude-sonnet-5-5 · effort high → ran inside implementation')) fail(`show should print a covered step's model\n${shown.join('\n')}`);
  if (!shown.includes('– 5. review-2  (router) → off (optional)')) fail(`show should print nothing extra for a step without a model\n${shown.join('\n')}`);
  expectOk('step pending', st('step', 'review-2', 'pending'));
  if (read().steps[4].outcome !== null) fail('an open step keeps no outcome');
  const kept = fs.readFileSync(stateFile, 'utf8');
  if (st('step', 'review-2', 'failed').ok) fail('scripts/state should refuse failed without an outcome');
  if (fs.readFileSync(stateFile, 'utf8') !== kept) fail('a refused change must leave the state file as it was');
  expectOk('handoff pr', st('handoff', 'pr', '77', 'https://example.test/pr/77'));
  if (read().handoff.pr?.number !== 77) fail('handoff pr not set');

  expectOk('workflow selecting', st('workflow', 'selecting'));
  expectOk('reply 5on', st('reply', '5on'));
  s = read();
  if (s.steps[4].status !== 'pending' || s.steps[5].status !== 'pending') fail('review 2 and the comparison switch on together');
  expectOk('reply 1a', st('reply', '1a'));
  s = read();
  if (s.steps[0].skill !== 'addyosmani/spec-driven-development' || s.steps[0].alternatives[0].skill !== 'mattpocock/to-spec') fail(`swap: ${JSON.stringify(s.steps[0])}`);
  const edit = spawnSync(path.join(tmp, 'scripts', 'state'), [repo, 'reply', 'edit'], { encoding: 'utf8' });
  if (edit.status !== 2) fail(`reply edit should exit 2 (recompose), got ${edit.status}`);
  if (st('reply', '2a').ok) fail('a swap with no alternative should be refused');
  expectOk('reply go', st('reply', 'go'));
  if (read().status !== 'running') fail('go should start the workflow');
  expectOk('reply 5off while running', st('reply', '5off'));
  if (read().steps[5].status !== 'skipped') fail('review 2 and the comparison switch off together while running');
  expectOk('reply 5on while running', st('reply', '5on'));
  if (read().steps[4].status !== 'pending') fail('an optional step not started yet switches on while running');
  if (st('reply', '1b').ok) fail('swaps apply only while selecting');

  // Fresh CLI processes retain the boundary and skip both completed and disabled steps.
  expectOk('disable optional review before pause', st('reply', '5off'));
  const paused = st('reply', 'pause');
  expectOk('pause at the boundary', paused);
  if (!paused.out.includes('workflow paused')) fail('pause must report the persisted paused workflow');
  const resumed = st('reply', 'resume');
  expectOk('resume in a new process', resumed);
  if (!resumed.out.includes('workflow running')) fail('resume must report a running workflow');
  const afterResume = st('show');
  expectOk('show after resume', afterResume);
  const firstOpen = afterResume.out.split('\n').find((line) => /^[○▶⏸]/u.test(line));
  if (firstOpen !== '○ 7. pull-request  mattpocock/pr') fail(`resume should start at the first incomplete step\n${afterResume.out}`);
  expectOk('start first incomplete step', st('step', '7', 'running', '--model', 'claude-opus-5-5'));
  if (!st('show').out.includes('▶ 7. pull-request  mattpocock/pr  on claude-opus-5-5')) fail('resumed execution should start the pull request step');

  // scripts/record: composes a record scripts/stats reads back, and refuses unknown reviewers.
  const { parseRecord: parseBack } = require(path.join(ROOT, 'scripts/lib/runs'));
  const findingsFile = path.join(repo, 'findings.json');
  fs.writeFileSync(findingsFile, JSON.stringify([{ title: 'x', severity: 'high', found_by: ['review-1', 'review-2'], decision: 'fixed' }]));
  const rec = run('record', repo, '--findings', findingsFile, '--checklist', '9,5', '--session-model', 'claude-opus-5-5');
  const back = parseBack(rec.out);
  if (!rec.ok || back.kind !== 'ok' || back.record.findings.length !== 1 || back.record.steps.length !== 7 || back.record.checklist.passed !== null) {
    fail(`scripts/record\n${rec.out}`);
  }
  // The record carries the classification's provenance: its policy revision, rationale and facts.
  const cls = back.record.classification;
  if (cls?.policy !== 1 || !cls.rationale?.risk || !Array.isArray(cls.facts)) fail(`scripts/record should carry the classification\n${rec.out}`);
  fs.writeFileSync(findingsFile, JSON.stringify([{ title: 'x', severity: 'high', found_by: ['review-9'], decision: 'fixed' }]));
  if (run('record', repo, '--findings', findingsFile).ok) fail('scripts/record should refuse a finding from a step not in the workflow');
}

// A swap recalculates coverage from the newly selected skill's `invokes` before go: a step that
// ran inside the old implementation runs on its own after a swap to one that does not run it, and
// is covered again (with the skill that runs it) after the swap back. A light path never covers
// review 1.
{
  const repo = fs.mkdtempSync(path.join(tmp, 'swap-'));
  fs.mkdirSync(path.join(repo, '.router'));
  const stateFile = path.join(repo, '.router/state.json');
  const read = () => JSON.parse(fs.readFileSync(stateFile, 'utf8'));
  const st = (...a) => run('state', repo, ...a);
  const expectOk = (label, r) => { if (!r.ok) fail(`scripts/state ${label}\n${r.out}`); return r; };
  const byId = (id) => read().steps.find((x) => x.id === id);
  const pending = (s) => s.steps.forEach((x) => Object.assign(x, { status: 'pending', outcome: null, model: null }));
  const integrated = (mutate = () => {}) => variant((s) => {
    s.status = 'selecting';
    pending(s);
    s.handoff.branch = null;
    s.steps[2].alternatives = [{ skill: 'pstack/arena', reason: 'High cost: competing designs' },
      { skill: 'addyosmani/incremental-implementation', reason: 'thin slices' }];
    // Testing ran inside the implementation too, so it is a covered step of its own.
    s.steps.splice(3, 0, { ...s.steps[3], id: 'testing', phases: ['testing'], skill: 'mattpocock/tdd', reason: 'runs inside implement' });
    mutate(s);
  });

  // Integrated -> standalone: testing and review 1 are open steps of their own after the swap.
  fs.writeFileSync(stateFile, JSON.stringify(integrated()));
  let r = expectOk('reply 3a (to arena)', st('reply', '3a'));
  if (byId('implementation').skill !== 'pstack/arena') fail(`swap to arena: ${JSON.stringify(byId('implementation'))}`);
  for (const id of ['testing', 'review-1']) {
    if (byId(id).covered_by !== null) fail(`after a swap to arena, ${id} should run on its own: ${JSON.stringify(byId(id))}`);
    if (!r.out.includes(`${id} runs on its own`)) fail(`the swap should say ${id} runs on its own\n${r.out}`);
  }
  if (/inside/.test(st('show').out)) fail(`show should list no covered step after the swap\n${st('show').out}`);
  // Closing the implementation leaves the independent checks pending.
  expectOk('go', st('reply', 'go'));
  expectOk('implementation running', st('step', 'implementation', 'running', '--model', 'claude-opus-5-5'));
  expectOk('implementation done', st('step', 'implementation', 'done', '--outcome', 'Built'));
  for (const id of ['testing', 'review-1']) {
    if (byId(id).status !== 'pending') fail(`${id} should stay pending when the implementation closes: ${JSON.stringify(byId(id))}`);
  }

  // Standalone -> integrated: the checks the new implementation runs are covered again, by the
  // skill it invokes, and close with it.
  fs.writeFileSync(stateFile, JSON.stringify(integrated((s) => {
    s.steps[2].skill = 'addyosmani/incremental-implementation';
    s.steps[2].alternatives = [{ skill: 'mattpocock/implement', reason: 'test-first, reviews itself' }];
    Object.assign(s.steps[3], { covered_by: null, skill: 'addyosmani/test-driven-development' });
    Object.assign(s.steps[4], { covered_by: null, skill: 'addyosmani/code-review-and-quality',
      alternatives: [{ skill: 'mattpocock/code-review', reason: 'r' }] });
  })));
  r = expectOk('reply 3a (to implement)', st('reply', '3a'));
  for (const [id, skill] of [['testing', 'mattpocock/tdd'], ['review-1', 'mattpocock/code-review']]) {
    const step = byId(id);
    if (step.covered_by !== 'implementation' || step.skill !== skill || step.alternatives.length !== 0)
      fail(`after a swap to implement, ${id} should run inside it with ${skill}: ${JSON.stringify(step)}`);
    if (!r.out.includes(`${id} runs inside implementation`)) fail(`the swap should say ${id} runs inside implementation\n${r.out}`);
  }
  expectOk('go', st('reply', 'go'));
  expectOk('implementation done', st('step', 'implementation', 'done', '--outcome', 'Built'));
  if (byId('review-1').status !== 'done' || byId('testing').status !== 'done') fail('covered steps should close with their implementation');

  // Light path: review 1 stays independent whatever the implementation runs.
  fs.writeFileSync(stateFile, JSON.stringify(integrated((s) => {
    s.path = 'light';
    s.steps.splice(3, 1);
    s.steps[2].skill = 'addyosmani/incremental-implementation';
    s.steps[2].alternatives = [{ skill: 'mattpocock/implement', reason: 'r' }];
    Object.assign(s.steps[3], { covered_by: null, skill: 'addyosmani/code-review-and-quality' });
  })));
  expectOk('reply 3a on a light path', st('reply', '3a'));
  if (byId('review-1').covered_by !== null || byId('review-1').skill !== 'addyosmani/code-review-and-quality')
    fail(`a light path never covers review 1: ${JSON.stringify(byId('review-1'))}`);
}

// compose: the selector-to-state boundary. A composed workflow becomes the executable state only
// when every skill and alternative is a usable candidate for its step's phases, with coverage
// recalculated from what the skills run. A new run (--new) never overwrites an unfinished one; a
// recomposition keeps the completed steps, the run's primary and the handoff, and reconsiders only
// the remaining work.
{
  const repo = fs.mkdtempSync(path.join(tmp, 'compose-'));
  const stateFile = path.join(repo, '.router/state.json');
  const composed = path.join(tmp, 'composed.json');
  const read = () => JSON.parse(fs.readFileSync(stateFile, 'utf8'));
  const compose = (state, ...flags) => {
    fs.writeFileSync(composed, JSON.stringify(state));
    return run('state', repo, 'compose', ...flags, composed);
  };
  const fresh = (mutate = () => {}) => variant((s) => {
    s.status = 'selecting';
    s.steps.forEach((x) => Object.assign(x, { status: 'pending', outcome: null, model: null }));
    s.handoff.branch = null;
    s.handoff.base_commit = null;
    s.steps[2].alternatives = [{ skill: 'addyosmani/incremental-implementation', reason: 'thin slices' }];
    mutate(s);
  });
  const expectRefused = (label, state, flags, msg) => {
    const before = fs.existsSync(stateFile) ? fs.readFileSync(stateFile, 'utf8') : null;
    const r = compose(state, ...flags);
    if (r.ok || !r.out.includes(`error: ${msg}`)) fail(`compose, ${label}: expected error: ${msg}\ngot:\n${r.out}`);
    if ((fs.existsSync(stateFile) ? fs.readFileSync(stateFile, 'utf8') : null) !== before) fail(`compose, ${label}: a refused composition must leave the state as it was`);
  };

  // Unknown, unusable or misplaced references never reach the state.
  expectRefused('unknown skill', fresh((s) => { s.steps[2].skill = 'nobody/nothing'; }), ['--new'],
    'implementation: nobody/nothing: unknown skill (choose another, or report implementation as missing)');
  expectRefused('a guide', fresh((s) => { s.steps[0].alternatives[0].skill = 'mattpocock/ask-matt'; }), ['--new'],
    'specification: alternative mattpocock/ask-matt: a guide, not an executable skill');
  expectRefused('wrong phase', fresh((s) => { s.steps[3].skill = 'mattpocock/tdd'; s.steps[3].covered_by = null; }), ['--new'],
    'review-1: mattpocock/tdd: not a candidate for review');
  fs.writeFileSync(prefsFile, 'preferences:\n  exclude: [addyosmani/incremental-implementation]\n');
  expectRefused('an excluded alternative', fresh(), ['--new'], 'implementation: alternative addyosmani/incremental-implementation: excluded');
  fs.rmSync(prefsFile);
  expectRefused('unknown phase', fresh((s) => { s.steps[2].phases = ['coding']; }), ['--new'], 'implementation: unknown phase coding');
  expectRefused('recompose without a run', fresh(), [], 'no workflow to recompose');

  // A new run: written as selecting, with coverage taken from what the implementation runs.
  let r = compose(fresh((s) => { s.steps[2].skill = 'addyosmani/incremental-implementation';
    s.steps[2].alternatives = [{ skill: 'mattpocock/implement', reason: 'r' }]; delete s.primary; }), '--new');
  if (!r.ok || !r.out.includes('coverage: review-1 runs on its own')) fail(`compose --new should write the run and recalculate coverage\n${r.out}`);
  let s = read();
  if (s.status !== 'selecting' || s.primary !== 'claude' || s.steps[3].covered_by !== null) fail(`compose --new: ${JSON.stringify(s)}`);

  // An unfinished run is resumed or discarded, never replaced by --new.
  if (!run('state', repo, 'reply', 'go').ok) fail('go after compose');
  expectRefused('--new over an unfinished run', fresh(), ['--new'], 'an unfinished workflow (running) is in');

  // Recomposition mid-run: completed steps, primary and handoff stay; the rest is reconsidered.
  fs.writeFileSync(stateFile, JSON.stringify(variant((s) => {
    s.primary = 'openai';
    s.steps[2].status = 'pending';
  })));
  const done = read().steps.slice(0, 2);
  const remaining = fresh((s) => {
    s.primary = 'claude';
    s.steps[0] = { ...s.steps[0], skill: 'addyosmani/spec-driven-development', alternatives: [] };
    s.steps[2].skill = 'addyosmani/incremental-implementation';
    s.steps[2].alternatives = [];
  });
  r = compose(remaining);
  if (!r.ok) fail(`compose should recompose an unfinished run\n${r.out}`);
  s = read();
  if (JSON.stringify(s.steps.slice(0, 2)) !== JSON.stringify(done)) fail(`recomposition should keep completed steps as they ran\n${JSON.stringify(s.steps.slice(0, 2))}`);
  if (s.primary !== 'openai' || s.handoff.branch !== '42-csv-export' || s.handoff.issue?.number !== 42) fail(`recomposition should keep the run's primary and handoff: ${JSON.stringify(s)}`);
  if (s.status !== 'selecting' || s.steps[2].skill !== 'addyosmani/incremental-implementation' || s.steps[3].covered_by !== null)
    fail(`recomposition should take the new remaining work: ${JSON.stringify(s.steps.slice(2))}`);
  expectRefused('dropping a completed step', fresh((s) => { s.steps.shift(); }), [], 'specification: a recomposition keeps completed steps');

  // The classification is checked at the same boundary (classification.md): a new run needs one,
  // and an evidenced sensitive change cannot be written as a low-risk light path.
  const authz = { fact: 'authorization', where: 'src/auth/guard.ts', evidence: 'changes which roles pass canEditInvoice' };
  fs.rmSync(stateFile);
  expectRefused('a new run without classification', fresh((s) => { delete s.classification; }), ['--new'], 'classification: missing');
  expectRefused('a sensitive change as a low-risk light path', fresh((s) => {
    Object.assign(s, { risk: 'low', complexity: 'low', path: 'light' });
    Object.assign(s.classification, { ticket: true, facts: [authz] });
  }), ['--new'], 'classification: risk low is below the minimum high set by authorization (src/auth/guard.ts: changes which roles pass canEditInvoice)');
  // A run approved under an earlier policy keeps its classification when recomposed without
  // revising it: no silent reclassification. A revision is checked against the current policy.
  fs.mkdirSync(path.dirname(stateFile), { recursive: true });
  fs.writeFileSync(stateFile, JSON.stringify(variant((s) => { s.classification.policy = 0; s.steps[2].status = 'pending'; })));
  r = compose(fresh((s) => { delete s.classification; delete s.type; delete s.risk; delete s.complexity; delete s.path; delete s.properties; }));
  s = read();
  if (!r.ok || !r.out.includes('classification: kept (policy 0)') || s.classification.policy !== 0 || s.risk !== 'medium' || s.type !== 'feature')
    fail(`a recomposition should keep the run's classification\n${r.out}\n${JSON.stringify(s.classification)}`);
  // `full` from a light path keeps the classification: full is always offered.
  fs.writeFileSync(stateFile, JSON.stringify(variant((s) => { s.classification.policy = 0; s.path = 'light'; s.steps[2].status = 'pending'; })));
  r = compose(fresh((s) => { s.classification.policy = 0; s.path = 'full'; }));
  if (!r.ok || !r.out.includes('classification: kept (policy 0)') || read().path !== 'full') fail(`full should keep the run's classification\n${r.out}`);
  expectRefused('a revision under an old policy', fresh((s) => { s.classification.policy = 0; s.risk = 'high'; }), [],
    'classification.policy: must be 1 (the current policy), got 0');
  r = compose(fresh((s) => { s.risk = 'high'; s.classification.facts = [authz]; s.classification.rationale.risk = 'the export now checks roles'; }));
  s = read();
  if (!r.ok || !r.out.includes('classification: revised under policy 1') || s.risk !== 'high' || s.classification.facts.length !== 1)
    fail(`an explicit recomposition may revise the classification under the current policy\n${r.out}`);
}

// The run's primary family lives in the state: written from the preferences when the state has
// none, then kept whatever the preferences say, and every model the run shows follows it.
{
  const repo = fs.mkdtempSync(path.join(tmp, 'primary-'));
  fs.mkdirSync(path.join(repo, '.router'));
  const stateFile = path.join(repo, '.router/state.json');
  const read = () => JSON.parse(fs.readFileSync(stateFile, 'utf8'));
  const st = (...a) => run('state', repo, ...a);
  const prefs = (primary) => fs.writeFileSync(prefsFile, `preferences:
  models:
    claude: claude-bridge/claude-opus-5-5
    openai: openai-codex/gpt-6-sol
${primary ? `  primary: ${primary}\n` : ''}  effort: medium
`);
  const fresh = variant((s) => { delete s.primary; s.status = 'selecting'; });

  prefs('openai');
  fs.writeFileSync(stateFile, JSON.stringify(fresh));
  if (!st('workflow', 'selecting').ok || read().primary !== 'openai') fail(`a state written without primary should take it from the preferences: ${read().primary}`);
  prefs('claude');
  if (!st('reply', 'go').ok || read().primary !== 'openai') fail(`a run should keep its own primary when the preferences change: ${read().primary}`);
  if (!st('reply', 'pause').ok || !st('reply', 'resume').ok || read().primary !== 'openai') fail(`a resumed run should keep its own primary: ${read().primary}`);
  const models = (primary) => `Models: claude claude-bridge/claude-opus-5-5 · openai openai-codex/gpt-6-sol · primary ${primary} · effort medium`;
  if (!st('show').out.split('\n').includes(models('openai'))) fail(`show should print the run's Models line\n${st('show').out}`);

  // Each step's model follows the run's primary; a phase's own model still wins, and review 2
  // runs on the family opposite to review 1's.
  const stepModels = () => ['implementation', 'review-1', 'review-2', 'specification'].map((id) => st('model', id).out.trim()).join(' ');
  const withReview2 = (s) => s.steps.push({ ...s.steps[3], id: 'review-2', skill: 'addyosmani/code-review-and-quality', covered_by: null, optional: true, status: 'skipped', outcome: 'off (optional)' });
  fs.writeFileSync(stateFile, JSON.stringify(variant((s) => { withReview2(s); s.primary = 'openai'; })));
  fs.writeFileSync(prefsFile, `preferences:\n  primary: claude\n  specification:\n    model: claude\n`);
  const C = 'claude-bridge/claude-opus-5-5';
  const O = 'openai-codex/gpt-6-sol';
  if (stepModels() !== [O, O, C, C].join(' ')) fail(`step models should follow the run's primary openai: ${stepModels()}`);
  fs.writeFileSync(stateFile, JSON.stringify(variant((s) => { withReview2(s); s.primary = 'claude'; })));
  fs.writeFileSync(prefsFile, `preferences:\n  primary: openai\n  review:\n    model: openai\n`);
  if (stepModels() !== [C, O, C, C].join(' ')) fail(`step models should follow the run's primary claude, review overridden to openai: ${stepModels()}`);
  if (st('model', 'nowhere').ok) fail('model should refuse an unknown step');

  prefs(null);
  fs.writeFileSync(stateFile, JSON.stringify(fresh));
  if (!st('workflow', 'selecting').ok || read().primary !== 'claude') fail(`primary should default to claude: ${read().primary}`);
  if (!st('show').out.split('\n').includes(models('claude'))) fail(`show should print the run's Models line\n${st('show').out}`);

  // The primary question: asked on a new run before the workflow is shown, the run's current
  // family first, so the preselected option and `1` keep it. A family name or its number sets it.
  prefs('claude');
  fs.writeFileSync(stateFile, JSON.stringify(variant((s) => { s.primary = 'openai'; s.status = 'selecting'; })));
  const question = 'Primary model family for this run:\n1. openai (openai-codex/gpt-6-sol)  current\n2. claude (claude-bridge/claude-opus-5-5)\n';
  if (st('primary').out !== question) fail(`primary should ask with the current family first\n${st('primary').out}`);
  // A selector reads the same options as data, current family first.
  const json = st('primary', '--json');
  const options = [
    { family: 'openai', label: 'openai (openai-codex/gpt-6-sol)', current: true },
    { family: 'claude', label: 'claude (claude-bridge/claude-opus-5-5)', current: false },
  ];
  if (!json.ok || JSON.stringify(JSON.parse(json.out)) !== JSON.stringify(options)) fail(`primary --json should print the options\n${json.out}`);
  // edit and full recompose the workflow: the run keeps its primary, and the router is told so.
  const recompose = spawnSync(path.join(tmp, 'scripts', 'state'), [repo, 'reply', 'edit'], { encoding: 'utf8' });
  if (recompose.status !== 2 || !recompose.stderr.includes('keep "primary": "openai"') || read().primary !== 'openai') {
    fail(`reply edit should keep the run's primary and say so\n${recompose.stderr}`);
  }
  fs.writeFileSync(stateFile, JSON.stringify(variant((s) => { withReview2(s); s.primary = 'claude'; s.status = 'selecting'; s.steps.forEach((x) => { x.status = 'pending'; x.outcome = null; x.model = null; x.effort = null; }); })));
  if (!st('primary', 'openai').ok || read().primary !== 'openai') fail(`primary openai should set the run's primary: ${read().primary}`);
  if (!st('show').out.split('\n').includes(models('openai'))) fail(`show should follow the chosen primary\n${st('show').out}`);
  if (st('model', 'review-2').out.trim() !== C) fail(`review 2 should run on the family opposite to the chosen primary: ${st('model', 'review-2').out}`);
  if (!st('primary', '1').ok || read().primary !== 'openai') fail(`answer 1 should keep the current primary: ${read().primary}`);
  if (!st('primary', '2').ok || read().primary !== 'claude') fail(`answer 2 should switch to the other family: ${read().primary}`);
  if (st('primary', 'gemini').ok || st('primary', '3').ok || read().primary !== 'claude') fail('primary should refuse an answer that is not a family or its number');
  // Once the workflow has started, the run keeps its family: resume never asks again.
  if (!st('reply', 'go').ok) fail(`go should start the workflow\n${st('reply', 'go').out}`);
  if (st('primary', 'openai').ok || read().primary !== 'claude') fail('primary should be refused once the workflow has started');
  if (st('primary').ok) fail('the primary question should not be asked once the workflow has started');
  if (st('primary', '--json').ok) fail('the primary options should not be offered once the workflow has started');
  fs.rmSync(prefsFile, { force: true });
}

// check-classification: the classification policy's constraints over explicit facts
// (skills/engineering-router/classification.md). Deterministic: the same facts under the same
// policy give the same minimum risk and offer; the task's wording is never read.
{
  const CLASSIFICATION_MD = 'skills/engineering-router/classification.md';
  const example = () => JSON.parse(fs.readFileSync(path.join(tmp, CLASSIFICATION_MD), 'utf8').match(/```json\n([\s\S]*?)```/)[1]);
  const file = path.join(tmp, 'classification.json');
  const classify = (c) => { fs.writeFileSync(file, JSON.stringify(c)); return run('check-classification', file); };
  const fact = (name, where = 'task') => ({ fact: name, where, evidence: `the change alters ${name}` });
  const of = (fields, facts = [], extra = {}) => {
    const c = example();
    Object.assign(c, fields);
    Object.assign(c.classification, { facts, ...extra });
    return c;
  };
  const expectOffer = (label, c, ...lines) => {
    const r = classify(c);
    const missing = lines.filter((l) => !r.out.split('\n').includes(l));
    if (!r.ok || missing.length) fail(`check-classification, ${label}: expected\n  ${missing.join('\n  ')}\ngot:\n${r.out}`);
  };
  const expectRefusedClass = (label, c, ...msgs) => {
    const r = classify(c);
    const missing = msgs.filter((m) => !r.out.includes(`error: ${m}`));
    if (r.ok || missing.length) fail(`check-classification, ${label}: expected\n  error: ${missing.join('\n  error: ')}\ngot:\n${r.out}`);
  };

  // The documented example: a simple-but-sensitive bug fix gets no shortcut.
  expectOffer('the classification.md example', example(),
    'policy: 1', 'minimum risk: high (authorization: src/auth/guard.ts)', 'offer: full');
  // An evidenced sensitive change classified low is a conflict, never a low-risk shortcut.
  for (const name of ['authorization', 'payment', 'destructive']) {
    expectRefusedClass(`${name} at low risk`, of({ risk: 'low', complexity: 'low' }, [fact(name)]),
      `risk low is below the minimum high set by ${name} (task: the change alters ${name})`);
  }
  expectRefusedClass('sensitive data at low risk', of({ risk: 'low' }, [fact('sensitive-data', 'src/log.ts')]),
    'risk low is below the minimum medium set by sensitive-data (src/log.ts: the change alters sensitive-data)');
  // Harmless work is not forced into a workflow by its words: docs that mention authorization,
  // with no fact, get the low-risk offer. Complex-but-low-impact work stays low risk.
  const docs = of({ type: 'documentation', risk: 'low', complexity: 'low',
    task: 'Document the authorization and payment pages; drop the outdated screenshots' });
  expectOffer('harmless docs with misleading words', docs, 'minimum risk: low (no constraining facts)', 'offer: direct, light, full');
  expectOffer('complex but low impact', of({ type: 'documentation', risk: 'low', complexity: 'high' }), 'offer: direct, light, full');
  expectOffer('low risk, not a ticket', of({ risk: 'low' }, [], { ticket: false }), 'offer: direct, full');
  // A bounded medium-risk ticket of low complexity: light proposed, full available; never light without a ticket.
  expectOffer('bounded bug fix', of({ risk: 'medium', complexity: 'low' }, [fact('public-contract', 'src/api.ts')]), 'offer: light, full', 'propose: light');
  expectOffer('medium, not a ticket', of({ risk: 'medium', complexity: 'low' }, [], { ticket: false }), 'offer: full');
  expectOffer('medium, medium complexity', of({ risk: 'medium', complexity: 'medium' }), 'offer: full');
  // Explicit user choice: full is always honored; a smaller path than the policy offers is reported.
  expectOffer('full requested at low risk', of({ risk: 'low', requested: 'full', path: 'full' }), 'offer: direct, light, full');
  expectRefusedClass('direct requested on a sensitive change', of({ requested: 'direct' }, [fact('payment')]),
    'requested direct is not offered (risk high, complexity low, a ticket): offer full');
  expectRefusedClass('light path on a sensitive change', of({ path: 'light' }, [fact('destructive')]), 'path light is not offered');
  // Facts need evidence of where they hold, and belong to the policy.
  expectRefusedClass('a fact without evidence', of({}, [{ fact: 'authorization', where: 'task' }]),
    'classification.facts[0]: authorization needs where (task or an inspected file) and evidence');
  expectRefusedClass('an unknown fact', of({}, [fact('scary')]), 'classification.facts[0]: unknown fact "scary"');
  expectRefusedClass('another policy revision', of({}, [], { policy: 0 }), 'classification.policy: must be 1 (the current policy), got 0');
  expectRefusedClass('no rationale', of({}, [], { rationale: { type: 'x' } }),
    'classification.rationale.risk: needs a reason', 'classification.rationale.complexity: needs a reason');
  // Identical facts under the same policy give the same result, whatever the task says.
  const a = classify(of({ task: 'A' }, [fact('payment')])).out;
  const b = classify(of({ task: 'Something else entirely' }, [fact('payment')])).out;
  if (a !== b) fail(`check-classification should depend on the facts only\n${a}\n${b}`);
  const uncertain = classify(of({ risk: 'medium', complexity: 'low' }, [], { uncertain: ['the issue does not say whether exports include emails'] }));
  if (!uncertain.out.includes('uncertain: the issue does not say whether exports include emails')) fail(`check-classification should print uncertainty\n${uncertain.out}`);

  // Classification evaluation cases (evals/classification/cases.yaml) are judged by running a
  // model; here only their contract is checked: they name the model, effort and current policy
  // revision, cover the required kinds, use the policy's facts, and an ambiguous case describes
  // its ambiguity instead of asserting one answer.
  const YAML = require(path.join(ROOT, 'node_modules/yaml'));
  const evals = YAML.parse(fs.readFileSync(path.join(ROOT, 'evals/classification/cases.yaml'), 'utf8'));
  const { policy } = require(path.join(ROOT, 'scripts/lib/classification'));
  const current = policy();
  for (const key of ['model', 'effort']) if (!evals.evaluation?.[key]) fail(`classification evals should record the evaluation ${key}`);
  if (evals.evaluation?.policy !== current.revision) fail(`classification evals should name policy ${current.revision}, got ${evals.evaluation?.policy}`);
  const kinds = new Set();
  for (const c of evals.cases ?? []) {
    if (!c.id || !c.task || !c.kind || !c.expect) fail(`classification eval case needs id, task, kind and expect: ${c.id}`);
    kinds.add(c.kind);
    for (const f of [...(c.expect.facts ?? []), ...(c.expect.not_facts ?? [])])
      if (!Object.hasOwn(current.facts, f)) fail(`classification eval ${c.id}: unknown fact ${f}`);
    if (c.kind === 'ambiguous' && (!c.ambiguity || c.expect.risk)) fail(`classification eval ${c.id}: an ambiguous case describes its ambiguity and asserts no single risk`);
  }
  const KINDS = ['harmless-docs', 'bounded-bug', 'authorization', 'payment', 'destructive', 'ambiguous',
    'simple-but-sensitive', 'complex-low-impact', 'misleading-terms'];
  const absent = KINDS.filter((k) => !kinds.has(k));
  if (absent.length) fail(`classification evals need cases of kind: ${absent.join(', ')}`);
}

const adapterDir = path.join(ROOT, 'adapters/pi');
const adapterTests = fs.readdirSync(adapterDir).filter((f) => f.endsWith('.test.ts')).map((f) => path.join(adapterDir, f));
const adapter = spawnSync(process.execPath, ['--test', ...adapterTests], { encoding: 'utf8' });
if (adapter.status !== 0) fail(`Pi adapter tests\n${adapter.stdout}${adapter.stderr}`);
console.log('selftest OK');
