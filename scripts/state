#!/usr/bin/env node
// Usage: scripts/state <target-repo> <command> ...
// The router's only way to change `.router/state.json` after writing it the first time.
// Every candidate is validated with scripts/check-state before state or artifact writes.
//
//   step <n|id> <status> [--outcome "..."] [--model <model ID>] [--effort low|medium|high] [--main-session]
//        pending | running | waiting | done | skipped | failed; done, skipped and failed need
//        an outcome. Delegated running/done use start/deliver instead (step-result.md);
//        --main-session runs other skill steps in the main session; PR preparation uses
//        start/deliver. A covering step carries others: running starts them and gives
//        those still open without a model its model and effort; done or failed closes those
//        still open with its model and effort. A running or waiting step sets the workflow's
//        status.
//   checklist set <file>     JSON [{action, expected}], at most 15 checklist points.
//   checklist check <run> <id> on|off
//                            owner-only personal tick; stale run/item intents are refused.
//                            reply "checklist <run> <id> on|off" forwards the same intent.
//   workflow <status>        selecting | running | waiting | done | paused | stopped
//   handoff issue <n> <url> | spec <path> | ticket <n> <url> | branch <name> | base <sha|HEAD> | pr <n> <url>
//   reply <reply>            a selection reply: go, 2b, 5on, 5off, primary <family>, stop, pause, resume.
//                            A swap restores, as steps of their own, the tests and reviews the
//                            old skill ran inside the step, and recalculates coverage from the
//                            newly selected skill.
//                            edit and full exit 2: reselect and recompose (SKILL.md §3-§4).
//   primary [<family>|<n>]   without an answer, the primary question: the two families with
//                            their models, the run's current one first (1 keeps it). When the
//                            preferences name `primary`, no question: a `primary:` line with the
//                            run's family and the reply that changes it. --json prints
//                            {preferences: <family>|null, options: [{family, label, current}]}
//                            for a selector. With an answer (or the reply `primary <family>`),
//                            sets the run's primary. Only while the workflow is selecting.
//   compose [--new] --classification <file> --selection <file> --task "..."
//           [--issue <n|url>] [--spec <path>] [--checkpoint <step>[,<step>]] [--reselect]
//                            builds the workflow's steps (SKILL.md §2, §4) from the checked
//                            classification and selection and writes them as the state, status
//                            selecting; prints the workflow presentation (SKILL.md §5). Both files
//                            are checked again (check-classification, check-selection); a failed
//                            check writes nothing. Coverage is calculated from what the skills
//                            invoke. --new starts a run and refuses to replace an unfinished one;
//                            without it, --selection recomposes the current run: completed steps
//                            (done, failed, skipped after running) stay as they ran, and the run
//                            keeps its primary, handoff, checklist, reviewed revisions and, unless
//                            --classification revises it, its classification; an --issue or --spec
//                            other than its handoff is refused. --spec names an existing file.
//                            --reselect is passed on to check-selection. A file holding a
//                            complete state, positional or as --selection, is refused.
//   show                     the workflow presentation of compose, with the step model when set
//                            and the run's Models line (primary from the state)
//   start <n|id> [--requires note,findings,pr-body] [--purpose "..."] [--env "..."]
//                [--model <model ID>] [--effort low|medium|high] [--user-approved]
//                            starts a pending delegated step with its resolved model/effort,
//                            or opens a new attempt on a running one. Starts the run-headed note
//                            and prints the brief and reusable checks. A further accepted review
//                            pass needs a purpose none of its earlier passes served.
//                            --fixes opens the fixes run's attempt on a review with actionable
//                            findings, printing the code writer's model; the step keeps its own.
//   deliver <n|id> [<file>]  checks the result and artifacts; a refused delivery writes nothing,
//                            leaving the attempt open. done closes with the summary as outcome
//                            and records optional result handoff; fixes stays running, blocked waits.
//                            A review closes once no finding is actionable and no re-check is due.
//   decide <n|id> <finding> declined|deferred --reason "..."
//                            the main session's decision on a finding (number or title) after the
//                            review's accepted fixes verdict; the last one closes the step.
//   artifact <n|id> <kind>   the path of an artifact an accepted done delivery carries
//   progress <n|id> --done "..." [--next "..."] [--limits "..."] [--user-approved]
//                            a running step's progress record (state.md "Progress"), with the
//                            checkout's branch, HEAD and uncommitted paths; ends an interruption.
//                            Past its retries (and for start) it needs --user-approved
//   check <n|id> pass|fail|interrupted --command "..." --env "..." [--scope <path>,<path>]
//                            a check the running step ran, tied to the content of its scope
//                            (default: the whole repo); a rerun of a command replaces its result
//   interrupt <n|id> --reason "..."
//                            the running step stopped before it ended (timeout, quota, model
//                            unavailable): it stays running, neither done nor waiting
//   recover [--env "..."]    read-only: each open step's record against the current checkout,
//                            which checks hold and which rerun, and where to continue (resume.md)
//
// Ownership (ADR 0002): only the session in the state's `owner` changes the workflow; any other
// is refused, as is any change to a workflow with no owner recorded until it is claimed. The
// session is `--session <id>`, else $ROUTER_SESSION, $CLAUDE_CODE_SESSION_ID or $PI_SESSION_ID.
// `compose --new` makes this session the owner of a new run.
//   claim                    this session becomes owner of a workflow with no owner (or keeps it);
//                            refused when another session owns it
//   takeover --previous-closed
//                            the explicit handover, once the user confirmed the owning session is
//                            closed: this session becomes owner, the previous one is recorded and
//                            refused from then on. An unowned workflow is claimed instead.
//   owner                    who owns the workflow: this session, another one, or none recorded
//   discard                  archives the state and its notes in .router/runs/<run>/ and removes them
//   reconcile                the state beside the repo, for a resume: run, owner, branch, commits
//                            since the base, the PR's state (gh), each note in .router/steps/ with
//                            the run it belongs to, and the next step. Changes nothing.
// `start <n>` (or main-session `step <n> running`) starts `.router/steps/<n>-<id>.md`,
// headed `run: <run>`; a
// note another run left there moves to that run's archive. Locking, notes, archives and the
// reconciliation are in lib/run-files.js.
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const ops = require('./lib/state-ops');
const models = require('./lib/models');
const files = require('./lib/run-files');
const { lastJsonBlock } = require('./lib/json-block');
// The user configuration in effect (scripts/config), never the target repo's, read when a command
// needs it; an unreadable one stops the command with its errors instead of passing for the defaults.
let loaded;
const prefs = () => {
  const Catalog = require('./lib/catalog');
  loaded ??= Catalog.preferences(Catalog.requireConfig());
  return loaded;
};

// What a selected skill runs internally, for coverage (SKILL.md §4): the skills it `invokes` that
// are tagged with one of the phases, from the catalog beside this script plus the target's
// project skills.
const invokesFor = (target) => {
  const Catalog = require('./lib/catalog');
  Catalog.requireConfig();
  const skills = Catalog.skills(target);
  return (id, phases) => Catalog.arr(skills[id]?.invokes)
    .filter((inv) => Catalog.arr(skills[inv]?.categories).some((c) => phases.includes(c)));
};

const [target, command, ...rest] = process.argv.slice(2);
if (!target || !command) {
  console.error('usage: scripts/state <target-repo> compose|step|checklist|workflow|handoff|reply|primary|show|start|deliver|decide|artifact|progress|check|interrupt|recover|claim|takeover|owner|discard|reconcile ...');
  process.exit(1);
}
const file = path.join(target, '.router', 'state.json');
const die = (msg, code = 1) => {
  console.error(`error: ${msg}`);
  process.exit(code);
};
// The session running this command (ADR 0002); --session is taken out before the other flags.
const sessionAt = rest.indexOf('--session');
const flagSession = sessionAt >= 0 ? rest.splice(sessionAt, 2)[1] : undefined;
const SESSION_ENV = ['ROUTER_SESSION', 'CLAUDE_CODE_SESSION_ID', 'PI_SESSION_ID'];
const session = flagSession || SESSION_ENV.map((k) => process.env[k]).find(Boolean) || null;
const noIdentity = `no session identity: pass --session <id> or set ROUTER_SESSION (${SESSION_ENV.join(', ')} are read)`;
const now = () => new Date().toISOString().replace(/\.\d{3}Z$/, 'Z');
// Flags take a value, except these switches.
const SWITCHES = ['new', 'reselect', 'json', 'previous-closed', 'main-session', 'user-approved', 'fixes'];
const flags = {};
const args = [];
for (let i = 0; i < rest.length; i++) {
  if (!rest[i].startsWith('--')) args.push(rest[i]);
  else if (SWITCHES.includes(rest[i].slice(2))) flags[rest[i].slice(2)] = true;
  else flags[rest[i].slice(2)] = rest[++i] ?? '';
}

const READ_ONLY = ['show', 'owner', 'reconcile', 'artifact', 'recover'];
// One change at a time: every writing command holds `.router/state.lock` from reading the state
// to writing it, so two sessions claiming at once leave one owner.
if (!READ_ONLY.includes(command) && (command === 'compose' || fs.existsSync(path.dirname(file)))) {
  try {
    files.lock(path.dirname(file));
  } catch (e) {
    die(e.message);
  }
}
const artifactWrites = [];
if (command === 'compose') compose();
if (!fs.existsSync(file)) die(`.router/state.json not found in ${target}`);
const before = fs.readFileSync(file, 'utf8');
let state;
try {
  state = JSON.parse(before);
} catch (e) {
  die(`invalid JSON in ${file}: ${e.message}`);
}

// Refuses a change by any session but the owner (ADR 0002).
function requireOwner(current) {
  const owner = current?.owner?.session;
  if (!owner) die(`no owner recorded for the workflow in ${target}: claim it first with \`scripts/state ${target} claim\`, once no other session runs it (resume.md)`);
  if (!session) die(noIdentity);
  if (owner !== session) die(`the workflow in ${target} is owned by session ${owner} since ${current.owner.since}; this session (${session}) may not change it. Once the user confirms that session is closed, take it over explicitly with \`scripts/state ${target} takeover --previous-closed\` (resume.md)`);
}

// compose: the workflow built from the checked classification and selection (lib/compose.js)
// becomes the state, or the reason it cannot is printed and nothing is written.
function compose() {
  const isNew = flags.new === true;
  const usage = 'usage: scripts/state <target-repo> compose [--new] --classification <file> --selection <file> --task "..." [--issue <n|url>] [--spec <path>] [--checkpoint <step>[,<step>]] [--reselect]';
  const refused = `compose builds the steps itself: a file holding a complete state is refused. Pass the checked classification and selection instead (SKILL.md §5):\n${usage}`;
  if (args.length) die(refused);
  for (const key of ['classification', 'selection']) {
    if (flags[key] !== undefined && !fs.existsSync(flags[key])) die(`${usage}\nnot found: ${flags[key]}`);
  }
  if (!flags.selection || (isNew && (!flags.classification || !flags.task?.trim()))) die(usage);
  if (flags.spec && !fs.existsSync(path.resolve(target, String(flags.spec))))
    die(`--spec ${flags.spec}: no such file in the target repo; --spec names the existing spec file the task is (SKILL.md §2)`);
  const readJson = (f) => {
    try {
      return JSON.parse(fs.readFileSync(f, 'utf8'));
    } catch (e) {
      return die(`invalid JSON in ${f}: ${e.message}`);
    }
  };
  const previous = fs.existsSync(file) ? readJson(file) : null;
  if (isNew && ops.UNFINISHED.includes(previous?.status))
    die(`an unfinished workflow (${previous.status}) is in ${target}: resume it or discard it first (resume.md)`);
  if (!isNew) {
    if (![...ops.UNFINISHED, 'selecting'].includes(previous?.status)) die(`no workflow to recompose in ${target}: start one with compose --new`);
    requireOwner(previous);
  } else {
    // A new run is owned by this session from its start; another session's selection stays.
    if (!session) die(noIdentity);
    if (previous?.status === 'selecting' && previous.owner?.session) requireOwner(previous);
  }

  // The inputs pass the same checks the router ran on them, with the same errors.
  const checked = (script, ...argv) => {
    const r = spawnSync(path.join(__dirname, script), argv, { encoding: 'utf8' });
    if (r.status !== 0) {
      process.stderr.write(`${r.stdout}${r.stderr}`);
      die(`${script} refused ${argv.at(-1)}; nothing was written`);
    }
    return r.stdout;
  };
  const selection = (() => {
    const text = fs.readFileSync(flags.selection, 'utf8');
    try {
      return JSON.parse(lastJsonBlock(text) ?? text);
    } catch {
      return null; // check-selection names what is wrong with it
    }
  })();
  if (selection && (Array.isArray(selection.steps) || selection.version !== undefined)) die(refused);
  const given = flags.classification ? readJson(flags.classification) : null;
  const classified = classification(given, flags.classification, isNew ? null : previous, checked);
  checked('check-selection', '--target', target, ...(flags.reselect ? ['--reselect'] : []), flags.selection);

  const handoff = isNew ? givenHandoff() : keptHandoff(previous);

  const Catalog = require('./lib/catalog');
  Catalog.requireConfig();
  const Compose = require('./lib/compose');
  const built = Compose.build({
    classification: classified.fields, selection, skills: Catalog.skills(target),
    trackerConfigured: fs.existsSync(path.join(target, Compose.TRACKER_FILE)),
    issue: handoff.issue, checkpoints: (flags.checkpoint ?? '').split(',').map((c) => c.trim()).filter(Boolean),
  });
  const errors = [...built.errors];
  const next = {
    version: 1, task: flags.task?.trim() || previous?.task, ...classified.fields,
    status: 'selecting', updated_at: now(), steps: built.steps, handoff,
    omitted: Catalog.arr(selection.omitted).map((o) => ({ phase: o.phase, reason: o.reason })),
    missing: [...Catalog.arr(selection.missing), ...built.missing].map((m) => ({ phase: m.phase, reason: m.reason })),
  };
  if (isNew) {
    next.run = `${now().replace(/[-:]/g, '')}-${files.token(2)}`;
    next.owner = { session, since: now(), previous: null };
    next.manual_checklist = [];
    // What a later run needs to tell whether this run's selections still hold (ADR 0005).
    next.reviewed = require('./lib/decided').reviewed();
  } else errors.push(...recompose(next, previous));
  if (errors.length) die(errors.join('\nerror: '));
  const covered = ops.recalculateCoverage(next, invokesFor(target));
  // A new run archives the previous one, its notes with it, once the new state is valid.
  const archived = () => [
    ...(isNew && previous ? [`archived: the previous run in ${files.archive(target, previous)}`] : []),
    '', ...Compose.present(covered.state, prefs()),
  ];
  write(covered.state, `compose${isNew ? ' --new' : ''}`, [classified.line, ...built.notes, ...covered.notes.map((n) => `coverage: ${n}`)], archived);
}

// The handoff a new run starts from: the issue or existing spec file the task already is.
function givenHandoff() {
  let handoff = { issue: null, spec: null, tickets: [], branch: null, base_commit: null, pr: null };
  try {
    if (flags.issue) {
      const number = String(flags.issue).match(/(\d+)\/?$/)?.[1];
      handoff = ops.setHandoff({ handoff }, 'issue', [number, /^https?:/.test(flags.issue) ? flags.issue : '']).handoff;
    }
    if (flags.spec) handoff = ops.setHandoff({ handoff }, 'spec', [flags.spec]).handoff;
  } catch (e) {
    die(e.message);
  }
  return handoff;
}

// A recomposition keeps the run's handoff: an --issue or --spec that says otherwise is refused,
// never dropped.
function keptHandoff(previous) {
  const kept = previous.handoff;
  const given = givenHandoff();
  const differs = [
    flags.issue && given.issue.number !== kept?.issue?.number ? `--issue ${flags.issue}` : null,
    flags.spec && given.spec !== kept?.spec ? `--spec ${flags.spec}` : null,
  ].filter(Boolean);
  for (const d of differs) {
    die(`${d}: a recomposition keeps the run's handoff (issue ${kept?.issue ? `#${kept.issue.number}` : 'none'}, spec ${kept?.spec ?? 'none'}); `
      + `set it with \`scripts/state ${target} handoff\`, or start a new run with compose --new`);
  }
  return kept;
}

// What a recomposition carries over from the run into `next`: completed steps as they ran,
// its run, owner, primary, checklist and reviewed revisions. Returns the errors.
function recompose(next, previous) {
  const errors = [];
  next.run = previous.run;
  next.owner = previous.owner;
  // Completed work stays as it ran; only the remaining work is reconsidered.
  for (const old of previous.steps.filter(ops.ran)) {
    const i = next.steps.findIndex((x) => x.id === old.id);
    if (i === -1) errors.push(`${old.id}: a recomposition keeps completed steps (${old.status}): select its phase again`);
    else next.steps[i] = old;
  }
  if (previous.primary != null) next.primary = previous.primary;
  next.manual_checklist = previous.manual_checklist ?? [];
  // The run keeps the revisions it was composed under; a state from before them stays without.
  if (previous.reviewed !== undefined) next.reviewed = previous.reviewed;
  return errors;
}

// The classification (classification.md) the composed workflow carries, as { fields, line }. A new
// run's passes check-classification. A recomposition keeps the run's own, policy revision included,
// when none is given or the given one revises nothing (`path` full is always offered, so switching
// to it, light.md's `full`, revises nothing); a revised one is checked against the current policy.
function classification(given, file, previous, checked) {
  const KEYS = ['type', 'risk', 'complexity', 'properties', 'classification'];
  const fieldsOf = (c, p = c.path) => Object.fromEntries([
    ['type', c.type], ['risk', c.risk], ['complexity', c.complexity], ['path', p],
    ['properties', c.properties ?? []], ['classification', c.classification],
  ].filter(([, v]) => v !== undefined));
  const same = previous && (!given || (KEYS.every((k) => given[k] === undefined || JSON.stringify(given[k]) === JSON.stringify(previous[k]))
    && [undefined, null, previous.path, 'full'].includes(given.path)));
  if (same) {
    return { fields: fieldsOf(previous, given?.path ?? previous.path),
      line: `classification: kept (policy ${previous.classification?.policy ?? 'none recorded'})` };
  }
  const out = checked('check-classification', file);
  if (!['light', 'full'].includes(given.path)) die(`${file}: path must be light or full, the path §1 chose (classification.md); nothing was written`);
  const revision = out.match(/^policy: (\d+)/m)?.[1];
  return { fields: fieldsOf(given), line: `classification: ${previous ? 'revised under' : 'checked against'} policy ${revision}` };
}

// Validate the complete candidate before touching state, inline artifacts or notes.
function write(next, label, lines = [], after = () => []) {
  if (next.primary == null) next.primary = models.preferredPrimary(prefs());
  next.updated_at = now();
  const content = `${JSON.stringify(next, null, 2)}\n`;
  const check = spawnSync(path.join(__dirname, 'check-state'), [target, '--stdin'], { encoding: 'utf8', input: content });
  if (check.status !== 0) die(`the change would make the state invalid; kept the previous state\n${check.stdout}${check.stderr}`);
  for (const w of artifactWrites) fs.writeFileSync(path.join(target, w.path), w.content);
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, content);
  console.log(`state: ${label} → workflow ${next.status}`);
  for (const line of [...lines, ...after()]) console.log(line);
  process.exit(0);
}

if (command === 'show') {
  // The workflow as SKILL.md §5 presents it, the same lines compose prints; a started one with each
  // step's status and outcome.
  for (const line of require('./lib/compose').present(state, prefs())) console.log(line);
  process.exit(0);
}

if (command === 'primary' && !args.length) {
  try {
    ops.checkPrimaryOpen(state);
  } catch (e) {
    die(e.message);
  }
  const preset = models.presetPrimary(prefs());
  if ('json' in flags) console.log(JSON.stringify({ preferences: preset, options: models.primaryOptions(state, prefs()) }));
  else console.log(preset ? models.primaryPreset(state, prefs()) : models.primaryQuestion(state, prefs()));
  process.exit(0);
}

const ownerLine = () => {
  const o = state.owner;
  if (!o?.session) return 'owner: none recorded (claim it before any change, once no other session runs it)';
  const whose = o.session === session ? 'this session' : `another session${session ? `, not this one (${session})` : ''}`;
  return `owner: ${o.session} since ${o.since} (${whose})`;
};
if (command === 'owner') {
  console.log(ownerLine());
  process.exit(0);
}
if (command === 'reconcile') {
  for (const line of files.reconcile(target, state, ownerLine())) console.log(line);
  process.exit(0);
}

if (command === 'claim' || command === 'takeover') {
  if (!session) die(noIdentity);
  const owner = state.owner?.session;
  if (command === 'claim' && owner && owner !== session) requireOwner(state);
  if (command === 'takeover') {
    // The handover's precondition is the user's word that the owner is closed (resume.md).
    if (!owner) die(`no owner recorded for the workflow in ${target}: claim it instead with \`scripts/state ${target} claim\``);
    if (owner === session) die(`this session (${session}) already owns the workflow in ${target}: nothing to take over`);
    if (!('previous-closed' in flags)) die(`the workflow in ${target} is owned by session ${owner}: take it over only once the user confirms that session is closed, with --previous-closed`);
  }
  const claimed = owner === session ? state.owner : { session, since: now(), previous: command === 'takeover' ? owner : null };
  write({ ...state, owner: claimed }, command);
}
if (command === 'discard') {
  requireOwner(state);
  // Marked, so no later run remembers its selections (ADR 0005).
  const dir = files.archive(target, { ...state, discarded: true });
  fs.rmSync(file);
  console.log(`state: discarded → archived in ${dir}`);
  process.exit(0);
}

const results = require('./lib/step-result');
if (command === 'artifact') {
  try {
    console.log(path.join(target, results.artifact(state, args[0], args[1])));
  } catch (e) {
    die(e.message);
  }
  process.exit(0);
}

const progress = require('./lib/progress');
if (command === 'recover') {
  for (const line of progress.recovery(state, progress.checkout(target), flags.env)) console.log(line);
  process.exit(0);
}

// Both router handoffs and result handoffs resolve the same checkout-relative value.
function handoffValue(current, field, values) {
  if (field === 'base' && values[0] === 'HEAD') {
    const r = spawnSync('git', ['-C', target, 'rev-parse', 'HEAD'], { encoding: 'utf8', env: require('./lib/git-env')() });
    if (r.status !== 0) throw new Error(`git rev-parse HEAD failed in ${target}: ${r.stderr.trim()}`);
    values = [r.stdout.trim()];
  }
  return ops.setHandoff(current, field, values);
}

// Every command below changes the workflow: only its owner may (ADR 0002).
requireOwner(state);

let next;
let logged = args;
const notes = [];
const lines = [];
const replyWords = args.join(' ').trim().split(/\s+/);
try {
  if (command === 'step') {
    const unaccepted = results.stepProblem(state, args[0], args[1], { inSession: flags['main-session'] === true });
    if (unaccepted) die(unaccepted);
    next = ops.setStep(state, args[0], args[1], flags);
  }
  else if (command === 'checklist' || (command === 'reply' && replyWords[0]?.toLowerCase() === 'checklist')) {
    const { setManualChecklist, checkChecklistPoint } = require('./lib/manual-checklist');
    const intent = command === 'reply' ? ['check', ...replyWords.slice(1)] : args;
    if (intent[0] === 'set' && intent.length === 2) next = setManualChecklist(state, JSON.parse(fs.readFileSync(intent[1], 'utf8')));
    else if (intent[0] === 'check' && intent.length === 4) next = checkChecklistPoint(state, ...intent.slice(1));
    else throw new Error('usage: checklist set <file> | checklist check <run> <id> on|off');
  }
  else if (command === 'workflow') next = ops.setWorkflow(state, args[0]);
  else if (command === 'primary' || (command === 'reply' && args[0]?.toLowerCase() === 'primary')) {
    // The primary question's answer, or the workflow reply that changes a preset family.
    const answer = command === 'primary' ? args[0] : args[1];
    const family = models.primaryAnswer(state, prefs(), answer);
    if (!family) die(`primary must be ${models.FAMILIES.join(' | ')} or an option number from \`primary\`, got "${answer ?? ''}"`);
    next = ops.setPrimary(state, family);
    logged = command === 'primary' ? [family] : ['primary', family];
  }
  else if (command === 'handoff') {
    next = handoffValue(state, args[0], args.slice(1));
  } else if (command === 'reply') {
    // A swap changes what the step runs internally: coverage is recalculated before go.
    const replied = ops.reply(state, args.join(' '), invokesFor(target));
    next = replied.state;
    notes.push(...replied.notes);
  }
  else if (command === 'start') {
    prefs();
    if (flags.model !== undefined && !/^\S+$/.test(flags.model)) die('--model: expected a model ID without spaces');
    if (flags.effort !== undefined && !['low', 'medium', 'high'].includes(flags.effort)) die('--effort: expected low | medium | high');
    const requires = flags.requires === undefined ? undefined : flags.requires.split(',').map((k) => k.trim()).filter(Boolean);
    const attempt = files.token(4);
    const retry = progress.retryProblem(state, args[0], { approved: flags['user-approved'] === true });
    if (retry) die(retry);
    const i = ops.stepIndex(state, args[0]);
    const step = state.steps[i];
    if (!results.delegated(state, step)) die(`step ${step.id}: no delegated delivery; use step ${i + 1} running`);
    if (!['pending', 'running'].includes(step.status)) die(`step ${step.id} is ${step.status}: start needs a pending or running step`);
    const fixes = flags.fixes === true;
    // The fixes run on the code writer's model; the step keeps the review's attribution.
    const running = fixes ? state : ops.setStep(state, args[0], 'running', {
      model: flags.model ?? (step.status === 'running' ? step.model : null) ?? models.stepModel(state, step, prefs()),
      effort: flags.effort ?? (step.status === 'running' ? step.effort : prefs().effort) ?? null,
    });
    const expected = results.openAttempt(running, args[0], { requires, attempt, purpose: flags.purpose, fixes });
    const p = expected.state.steps[i].progress;
    if (p) {
      p.interrupted = null;
      if (flags['user-approved']) p.approved = p.interruptions;
    }
    // A restart, or a start after a recorded attempt, resumes: it gets the recovery plan.
    const resumes = step.status === 'running' || step.progress != null;
    const fixesRun = fixes ? models.fixesDispatch(state, step, prefs()) : null;
    const dispatch = fixes ? { model: flags.model ?? fixesRun.model, effort: flags.effort ?? fixesRun.effort } : running.steps[i];
    lines.push(`model: ${dispatch.model}`, `effort: ${dispatch.effort ?? 'harness default'}`,
      ...(resumes ? progress.recovery : progress.reusableChecks)(expected.state, progress.checkout(target), flags.env));
    next = expected.state;
    lines.push(...expected.lines);
  } else if (command === 'deliver') {
    const resultPath = results.attemptPaths(state, ops.stepIndex(state, args[0])).result;
    const read = (rel) => {
      const f = rel === resultPath && args[1] ? path.resolve(args[1]) : path.join(target, rel);
      return fs.existsSync(f) && fs.statSync(f).isFile() ? fs.readFileSync(f, 'utf8') : null;
    };
    const delivered = results.deliver(state, args[0], read, handoffValue);
    if (delivered.problems) {
      // Refused: nothing is written, the attempt stays open, the valid artifacts stay as they are.
      for (const p of delivered.problems) console.error(`error: ${p}`);
      for (const k of delivered.kept) console.error(`kept: ${k}`);
      process.exit(1);
    }
    artifactWrites.push(...delivered.writes);
    next = delivered.state;
    lines.push(...delivered.lines);
  } else if (command === 'decide') {
    const decided = results.decide(state, args[0], args[1], args[2], flags.reason);
    artifactWrites.push(...decided.writes);
    next = decided.state;
    lines.push(...decided.lines);
  }
  else if (['progress', 'check', 'interrupt'].includes(command)) {
    const checkout = progress.checkout(target);
    if (command === 'progress') next = progress.recordProgress(state, args[0], { ...flags, approved: flags['user-approved'] === true }, checkout, now());
    if (command === 'check') {
      const scope = flags.scope?.split(',').map((p) => p.trim()).filter(Boolean);
      next = progress.recordCheck(state, args[0], { result: args[1], command: flags.command, scope, environment: flags.env }, checkout, now());
    }
    if (command === 'interrupt') next = progress.recordInterruption(state, args[0], flags.reason, checkout, now());
  }
  else die(`unknown command ${command}`);
} catch (e) {
  die(e.message, e.code === 'RECOMPOSE' ? 2 : 1);
}

// A state written without a primary family takes the preferences'; a stored one stays for the run.
// A started step gets its note, headed by the run (ADR 0002).
// A fixes attempt's note is its own, beside the review's (step-result.md).
const started = () => {
  if (!(command === 'start' || (command === 'step' && args[1] === 'running')) || !next.run) return [];
  const i = ops.stepIndex(next, args[0]);
  return [files.startNote(target, next, i, command === 'start' ? results.attemptPaths(next, i).note : undefined)];
};
write(next, `${command} ${logged.join(' ')}`, [...notes.map((n) => `coverage: ${n}`), ...lines], started);
