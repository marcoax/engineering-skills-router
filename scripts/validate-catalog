#!/usr/bin/env node
// Validates the catalog against itself and the vendor checkouts. Exits 1 on errors.
// Uncataloged upstream skills are reported as info only (listed with --verbose).
// --target <repo> also checks that repo's project catalog (docs/agents/skills.yaml).
// The personal catalog (config/personal-skills.yaml) is checked when present; a personal skill
// named like a vendor skill is skipped with a warning.
const fs = require('node:fs');
const path = require('node:path');
const Catalog = require('./lib/catalog');

const { arr } = Catalog;
const { target, args } = Catalog.targetArg(process.argv.slice(2));
const verbose = args.includes('--verbose');
const errors = [];
const warnings = [];
const sources = Catalog.sources();
const prefs = Catalog.preferences();
const vendor = Catalog.vendorSkills();
const personalPath = Catalog.personalPath(prefs);
const personal = Catalog.personalSkills(personalPath);
const personalFile = path.join(Catalog.ROOT, Catalog.PERSONAL_CATALOG);
const hasPersonalCatalog = fs.existsSync(personalFile);
const skills = Catalog.skills();
const project = Catalog.projectSkills(target);
const categories = Catalog.categories();
const rankings = Catalog.rankings();
const has = (obj, key) => Object.hasOwn(obj, key);
// Personal ids left out for a vendor namesake, each mapped to that namesake.
const skipped = Object.fromEntries(Object.keys(personal).filter((id) => id.startsWith('personal/'))
  .map((id) => [id, Catalog.namesake(id, vendor)]).filter(([, namesake]) => namesake));

// YAML keeps only one of two duplicate keys, so check the raw text. `prefix` leads each error.
function checkDuplicateIds(file, prefix = '') {
  if (!fs.existsSync(file)) return;
  const ids = [...fs.readFileSync(file, 'utf8').matchAll(/^ {2}([\w.-]+\/[\w.-]+):/gm)].map((m) => m[1]);
  new Set(ids.filter((id, i) => ids.indexOf(id) !== i)).forEach((id) => errors.push(`${prefix}duplicate skill id: ${id}`));
}
checkDuplicateIds(path.join(Catalog.ROOT, 'catalog/skills.yaml'));
if (target) checkDuplicateIds(path.join(target, Catalog.PROJECT_CATALOG), `${Catalog.PROJECT_CATALOG}: `);
checkDuplicateIds(personalFile, `${Catalog.PERSONAL_CATALOG}: `);

// Checks every skill gets, vendor, personal or project. Only project skills fill the project
// phases. `known` holds the ids `invokes` may name; `rootLabel` names what a personal
// or project path must stay inside.
function checkSkill(where, id, s, known, rootLabel) {
  if (!id.startsWith(`${s.source}/`)) errors.push(`${where}: id must start with '${s.source}/'`);
  if (s.outside) errors.push(`${where}: path outside ${rootLabel}: ${s.declaredPath}`);
  else if (!Catalog.available(s)) errors.push(`${where}: path not found ${s.declaredPath ?? s.path}`);
  arr(s.categories).filter((c) => !has(categories, c)).forEach((c) => errors.push(`${where}: invalid category '${c}'`));
  if (arr(s.categories).length === 0) errors.push(`${where}: no categories`);
  arr(s.complexity).filter((c) => !['low', 'medium', 'high'].includes(c))
    .forEach((c) => errors.push(`${where}: invalid complexity '${c}'`));
  arr(s.invokes).forEach((ref) => { if (!has(known, ref)) errors.push(`${where}: invokes unknown skill ${ref}`); });
  const isProject = s.source === 'project';
  if (!isProject) arr(s.categories).filter((c) => Catalog.PROJECT_PHASES.includes(c))
    .forEach((c) => errors.push(`${where}: only project skills may fill '${c}'`));
}

for (const [key, src] of Object.entries(sources)) {
  if (!fs.existsSync(path.join(Catalog.ROOT, String(src.local_path ?? ''))))
    errors.push(`source ${key}: missing vendor checkout ${src.local_path} (run scripts/setup)`);
}

for (const [id, s] of Object.entries(vendor)) {
  if (!has(sources, s.source)) errors.push(`${id}: unknown source '${s.source}'`);
  checkSkill(id, id, s, vendor);
}

// The router resolves "Call the Skill tool with \"<name>\"" to <same-source>/<name>.
for (const [id, s] of Object.entries(vendor)) {
  if (!Catalog.available(s)) continue;
  const text = fs.readFileSync(path.join(Catalog.ROOT, s.path), 'utf8');
  for (const [, name] of text.matchAll(/Skill tool with "([\w.-]+)"/g)) {
    if (!has(vendor, `${s.source}/${name}`)) errors.push(`${id}: calls uncataloged skill ${s.source}/${name}`);
  }
}

for (const [id, s] of Object.entries(project)) {
  checkSkill(`${Catalog.PROJECT_CATALOG}: ${id}`, id, s, { ...skills, ...project }, 'the target repo');
}

// personal_path is read here, not in the preferences loop below.
if (has(prefs, 'personal_path') && !personalPath)
  errors.push(`preferences.personal_path: must be a non-empty string, got ${JSON.stringify(prefs.personal_path)}`);
else if (personalPath && !fs.statSync(personalPath, { throwIfNoEntry: false })?.isDirectory())
  errors.push(`preferences.personal_path: not a directory: ${prefs.personal_path}`);
if (hasPersonalCatalog && !personalPath) errors.push(`${Catalog.PERSONAL_CATALOG}: needs preferences.personal_path`);
for (const [id, s] of Object.entries(personal)) {
  const where = `${Catalog.PERSONAL_CATALOG}: ${id}`;
  if (has(skipped, id)) warnings.push(`${where}: skipped, same name as ${skipped[id]}`);
  else checkSkill(where, id, s, skills, 'personal_path');
}

Object.keys(rankings).filter((c) => !has(categories, c)).forEach((c) => errors.push(`rankings: unknown category '${c}'`));
Object.keys(categories).filter((c) => !has(rankings, c)).forEach((c) => warnings.push(`rankings: no entry for category '${c}'`));
for (const [cat, r] of Object.entries(rankings)) {
  for (const kind of ['preferred', 'fallback']) {
    for (const id of arr((r || {})[kind])) {
      if (!has(vendor, id)) errors.push(`rankings.${cat}.${kind}: unknown skill ${id}`);
      else if (!arr(vendor[id].categories).includes(cat))
        warnings.push(`rankings.${cat}.${kind}: ${id} is not tagged with category '${cat}'`);
    }
  }
}

const isModel = (v) => typeof v === 'string' && /^[^\s/]+\/\S+$/.test(v);
const FAMILIES = ['claude', 'openai'];
const isFamily = (v) => FAMILIES.includes(v);
const EFFORTS = ['low', 'medium', 'high'];
for (const [key, value] of Object.entries(prefs)) {
  if (key === 'update_check_days') {
    if (!Number.isInteger(value) || value < 0)
      errors.push(`preferences.update_check_days: must be an integer >= 0 (0 = never), got ${JSON.stringify(value)}`);
    continue;
  }
  if (key === 'models') {
    for (const [family, model] of Object.entries(value || {})) {
      if (!isFamily(family)) errors.push(`preferences.models: unknown family '${family}', use ${FAMILIES.join(' | ')}`);
      else if (!isModel(model)) errors.push(`preferences.models.${family}: must be 'provider/model-id', got ${JSON.stringify(model)}`);
    }
    continue;
  }
  if (key === 'personal_path') continue;
  if (key === 'effort') {
    if (!EFFORTS.includes(value)) errors.push(`preferences.effort: must be ${EFFORTS.join(' | ')}, got ${JSON.stringify(value)}`);
    continue;
  }
  if (key === 'primary') {
    if (!isFamily(value)) errors.push(`preferences.primary: must be ${FAMILIES.join(' | ')}, got ${JSON.stringify(value)}`);
    continue;
  }
  const model = key === 'exclude' ? undefined : (value || {}).model;
  if (model !== undefined && !isFamily(model))
    errors.push(`preferences.${key}.model: must be ${FAMILIES.join(' | ')}, got ${JSON.stringify(model)}`);
  const ids = key === 'exclude' ? arr(value) : arr((value || {}).prefer);
  if (key !== 'exclude' && !has(categories, key)) errors.push(`preferences: unknown phase '${key}'`);
  ids.forEach((id) => {
    if (has(skipped, id)) errors.push(`preferences.${key}: ${id} is skipped, same name as ${skipped[id]}`);
    else if (!has(skills, id)) errors.push(`preferences.${key}: unknown skill ${id}`);
  });
}

const cataloged = Object.values(vendor).map((s) => s.path);
const uncataloged = Object.values(sources).flatMap(Catalog.upstreamPaths).filter((p) => !cataloged.includes(p));

warnings.forEach((w) => console.log(`warning: ${w}`));
errors.forEach((e) => console.log(`error: ${e}`));
if (uncataloged.length > 0) {
  console.log(`info: ${uncataloged.length} upstream skill(s) not cataloged${verbose ? ':' : ' (--verbose to list)'}`);
  if (verbose) uncataloged.forEach((p) => console.log(`  ${p}`));
}
const counts = [`${Object.keys(vendor).length} skills`];
if (hasPersonalCatalog) counts.push(`${Object.keys(personal).filter((id) => has(skills, id)).length} personal`);
if (target) counts.push(`${Object.keys(project).length} project`);
console.log(errors.length === 0 ? `catalog OK (${counts.join(' + ')}, ${warnings.length} warning(s))` : `${errors.length} error(s)`);
process.exit(errors.length === 0 ? 0 : 1);
