#!/usr/bin/env node
// Validates the catalog against itself and the vendor checkouts. Exits 1 on errors.
// Uncataloged upstream skills are reported as info only (listed with --verbose).
// --target <repo> also checks that repo's project catalog (docs/agents/skills.yaml).
const fs = require('node:fs');
const path = require('node:path');
const Catalog = require('./lib/catalog');

const { arr } = Catalog;
const { target, args } = Catalog.targetArg(process.argv.slice(2));
const verbose = args.includes('--verbose');
const errors = [];
const warnings = [];
const sources = Catalog.sources();
const skills = Catalog.skills();
const project = Catalog.projectSkills(target);
const categories = Catalog.categories();
const rankings = Catalog.rankings();
const prefs = Catalog.preferences();
const has = (obj, key) => Object.hasOwn(obj, key);

// YAML keeps only one of two duplicate keys, so check the raw text.
const rawIds = [...fs.readFileSync(path.join(Catalog.ROOT, 'catalog/skills.yaml'), 'utf8')
  .matchAll(/^ {2}([\w.-]+\/[\w.-]+):/gm)].map((m) => m[1]);
new Set(rawIds.filter((id, i) => rawIds.indexOf(id) !== i))
  .forEach((id) => errors.push(`duplicate skill id: ${id}`));

for (const [key, src] of Object.entries(sources)) {
  if (!fs.existsSync(path.join(Catalog.ROOT, String(src.local_path ?? ''))))
    errors.push(`source ${key}: missing vendor checkout ${src.local_path} (run scripts/setup)`);
}

for (const [id, s] of Object.entries(skills)) {
  if (!id.startsWith(`${s.source}/`)) errors.push(`${id}: id must start with its source '${s.source}/'`);
  if (!has(sources, s.source)) errors.push(`${id}: unknown source '${s.source}'`);
  if (!Catalog.available(s)) errors.push(`${id}: path not found ${s.path}`);
  arr(s.categories).filter((c) => !has(categories, c)).forEach((c) => errors.push(`${id}: invalid category '${c}'`));
  if (arr(s.categories).length === 0) errors.push(`${id}: no categories`);
  arr(s.complexity).filter((c) => !['low', 'medium', 'high'].includes(c))
    .forEach((c) => errors.push(`${id}: invalid complexity '${c}'`));
  arr(s.invokes).forEach((ref) => { if (!has(skills, ref)) errors.push(`${id}: invokes unknown skill ${ref}`); });
}

// The router resolves "Call the Skill tool with \"<name>\"" to <same-source>/<name>.
for (const [id, s] of Object.entries(skills)) {
  if (!Catalog.available(s)) continue;
  const text = fs.readFileSync(path.join(Catalog.ROOT, s.path), 'utf8');
  for (const [, name] of text.matchAll(/Skill tool with "([\w.-]+)"/g)) {
    if (!has(skills, `${s.source}/${name}`)) errors.push(`${id}: calls uncataloged skill ${s.source}/${name}`);
  }
}

for (const [id, s] of Object.entries(project)) {
  const where = `${Catalog.PROJECT_CATALOG}: ${id}`;
  if (!id.startsWith('project/')) errors.push(`${where}: id must start with 'project/'`);
  if (s.outside) errors.push(`${where}: path outside the target repo: ${s.declaredPath}`);
  else if (!Catalog.available(s)) errors.push(`${where}: path not found ${s.declaredPath}`);
  for (const c of arr(s.categories)) {
    if (!has(categories, c)) errors.push(`${where}: invalid category '${c}'`);
    else if (!Catalog.PROJECT_PHASES.includes(c))
      errors.push(`${where}: project skills may only fill '${Catalog.PROJECT_PHASES.join("' | '")}', not '${c}'`);
  }
  if (arr(s.categories).length === 0) errors.push(`${where}: no categories`);
}

Object.keys(rankings).filter((c) => !has(categories, c)).forEach((c) => errors.push(`rankings: unknown category '${c}'`));
Object.keys(categories).filter((c) => !has(rankings, c)).forEach((c) => warnings.push(`rankings: no entry for category '${c}'`));
for (const [cat, r] of Object.entries(rankings)) {
  for (const kind of ['preferred', 'fallback']) {
    for (const id of arr((r || {})[kind])) {
      if (!has(skills, id)) errors.push(`rankings.${cat}.${kind}: unknown skill ${id}`);
      else if (!arr(skills[id].categories).includes(cat))
        warnings.push(`rankings.${cat}.${kind}: ${id} is not tagged with category '${cat}'`);
    }
  }
}

const isModel = (v) => typeof v === 'string' && /^[^\s/]+\/\S+$/.test(v);
const FAMILIES = ['claude', 'openai'];
const isFamily = (v) => FAMILIES.includes(v);
for (const [key, value] of Object.entries(prefs)) {
  if (key === 'update_check_days') {
    if (!Number.isInteger(value) || value < 0)
      errors.push(`preferences.update_check_days: must be an integer >= 0 (0 = never), got ${JSON.stringify(value)}`);
    continue;
  }
  if (key === 'models') {
    for (const [family, model] of Object.entries(value || {})) {
      if (!isFamily(family)) errors.push(`preferences.models: unknown family '${family}', use ${FAMILIES.join(' | ')}`);
      else if (!isModel(model)) errors.push(`preferences.models.${family}: must be 'provider/model-id', got ${JSON.stringify(model)}`);
    }
    continue;
  }
  if (key === 'primary') {
    if (!isFamily(value)) errors.push(`preferences.primary: must be ${FAMILIES.join(' | ')}, got ${JSON.stringify(value)}`);
    continue;
  }
  const model = key === 'exclude' ? undefined : (value || {}).model;
  if (model !== undefined && !isFamily(model))
    errors.push(`preferences.${key}.model: must be ${FAMILIES.join(' | ')}, got ${JSON.stringify(model)}`);
  const ids = key === 'exclude' ? arr(value) : arr((value || {}).prefer);
  if (key !== 'exclude' && !has(categories, key)) errors.push(`preferences: unknown phase '${key}'`);
  ids.forEach((id) => { if (!has(skills, id) && !has(project, id)) errors.push(`preferences.${key}: unknown skill ${id}`); });
}

const cataloged = Object.values(skills).map((s) => s.path);
const uncataloged = Object.values(sources).flatMap(Catalog.upstreamPaths).filter((p) => !cataloged.includes(p));

warnings.forEach((w) => console.log(`warning: ${w}`));
errors.forEach((e) => console.log(`error: ${e}`));
if (uncataloged.length > 0) {
  console.log(`info: ${uncataloged.length} upstream skill(s) not cataloged${verbose ? ':' : ' (--verbose to list)'}`);
  if (verbose) uncataloged.forEach((p) => console.log(`  ${p}`));
}
console.log(errors.length === 0
  ? `catalog OK (${Object.keys(skills).length} skills${target ? ` + ${Object.keys(project).length} project` : ''}, ${warnings.length} warning(s))`
  : `${errors.length} error(s)`);
process.exit(errors.length === 0 ? 0 : 1);
