#!/usr/bin/env node
// Usage: scripts/skill-index [--check]
// Regenerates docs/skill-index.md from catalog/guides.yaml, catalog/skills.yaml and the vendor
// checkouts. Descriptions come from each SKILL.md frontmatter (the loader list-skills uses) and
// links pin the checked-out vendor revision. Review the diff before committing it.
//   --check  write nothing; exit 1 when the committed index differs from a fresh one
// A description that cannot be read is shown as a diagnostic and reported on stderr.
const fs = require('node:fs');
const path = require('node:path');
const { spawnSync } = require('node:child_process');
const Catalog = require('./lib/catalog');

const INDEX = 'docs/skill-index.md';
const check = process.argv.includes('--check');
const sources = Catalog.sources();
const categories = Catalog.categories();
const guides = Catalog.guides();
const skills = Catalog.vendorSkills();
const ORCHESTRATOR = 'workflow-selection';
// Headings for the index; any other category is shown with its key capitalized.
const LABELS = {
  'code-understanding': 'Code understanding', prototype: 'Prototyping', 'issue-tracking': 'Issue tracking',
  'multi-session': 'Work across sessions', testing: 'Testing and verification', 'independent-review': 'Independent review',
  'framework-review': 'Framework review', 'pull-request': 'Pull requests', retrospective: 'Retrospectives',
  'context-management': 'Context management', 'skill-authoring': 'Skill authoring',
};
const label = (c) => LABELS[c] ?? `${c[0].toUpperCase()}${c.slice(1).replace(/-/g, ' ')}`;
const anchor = (title) => title.toLowerCase().replace(/[^\w\s-]/g, '').replace(/\s/g, '-');
const escape = (text) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\|/g, '\\|');
const byId = (entries) => Object.entries(entries).sort(([a], [b]) => a.localeCompare(b));
const plural = (n, word) => `${n} ${word}${n === 1 ? '' : 's'}`;

// A git hook exports GIT_DIR and GIT_INDEX_FILE; they would point git at the router repo.
const gitEnv = require('./lib/git-env')();
const revisions = {};
function revision(key) {
  if (revisions[key] === undefined) {
    const r = spawnSync('git', ['-C', path.join(Catalog.ROOT, String(sources[key]?.local_path ?? '')), 'rev-parse', 'HEAD'], { encoding: 'utf8', env: gitEnv });
    if (r.status !== 0) {
      console.error(`error: source ${key}: cannot read the checked-out revision (run scripts/setup)`);
      process.exit(1);
    }
    revisions[key] = r.stdout.trim();
  }
  return revisions[key];
}

function link(id, entry) {
  const source = sources[entry.source];
  if (!source || !Catalog.ownedBy(entry.path, source)) {
    console.error(`error: ${id}: not inside a known source checkout (run scripts/validate-catalog)`);
    process.exit(1);
  }
  const rel = path.relative(path.resolve(Catalog.ROOT, source.local_path), path.resolve(Catalog.ROOT, entry.path)).split(path.sep).join('/');
  return `[${id}](${String(source.repository).replace(/\.git$/, '')}/blob/${revision(entry.source)}/${rel})`;
}

const warnings = [];
function describe(id, entry) {
  const { text, error } = Catalog.description(entry);
  if (text !== undefined) return escape(text);
  warnings.push(`warning: ${id}: description unavailable: ${error}`);
  return `_(description unavailable: ${escape(error)})_`;
}

const activities = (cats) => (cats.length === 0 ? '—' : cats.map(label).join(', '));
const isPrinciple = (id) => id.split('/')[1].startsWith('principle-');
const orchestrators = byId(skills).filter(([, s]) => Catalog.arr(s.categories).includes(ORCHESTRATOR));
const principles = byId(skills).filter(([id, s]) => isPrinciple(id) && !Catalog.arr(s.categories).includes(ORCHESTRATOR));
const workflow = byId(skills).filter(([id, s]) => !isPrinciple(id) && !Catalog.arr(s.categories).includes(ORCHESTRATOR));
const groups = Object.keys(categories)
  .map((c) => [c, workflow.filter(([, s]) => Catalog.arr(s.categories)[0] === c)])
  .filter(([, list]) => list.length > 0);
const collections = Object.keys(sources).sort().map((key) => [key,
  Object.values(guides).filter((g) => g.source === key).length,
  Object.values(skills).filter((s) => s.source === key).length]);

const out = [];
const line = (...l) => out.push(...l);
line('# Skill index', '',
  'Browse the vendor guides and skills by type and activity. [Back to the README](../README.md).', '',
  '<!-- Generated by scripts/skill-index. Do not edit by hand: change the catalog and regenerate. -->', '',
  `The current catalog contains **${plural(Object.keys(guides).length, 'guide')}** ([registry](../catalog/guides.yaml)) and **${plural(Object.keys(skills).length, 'vendor skill')}** ([catalog](../catalog/skills.yaml)). Each appears once below. Entries are alphabetical within each group; their order expresses no routing preference.`, '',
  '| Collection | Guides | Skills |', '|---|---|---|',
  ...collections.map(([key, g, s]) => `| ${key} | ${g} | ${s} |`), '',
  '## Contents', '',
  `- [Guides](#guides): ${plural(Object.keys(guides).length, 'entry point')} for choosing skills and workflows.`,
  `- [Orchestrators](#orchestrators): ${orchestrators.length === 1 ? '1 skill that selects and runs' : `${orchestrators.length} skills that select and run`} a vendor workflow.`,
  `- [Principles](#principles): ${principles.length} focused rules for engineering decisions.`,
  `- [Workflow and supporting skills](#workflow-and-supporting-skills): ${workflow.length} skills grouped by activity.`, '',
  '## Reading the index', '',
  "Descriptions are the vendors' own, read from each `SKILL.md` frontmatter at the linked revision; only whitespace is normalized. Read the linked `SKILL.md` before choosing or running one: it owns the complete process, prerequisites and side effects. Source links point to the vendor commits checked out when this index was generated, so they work on GitHub as well as from a local Markdown viewer.", '',
  'The four types are a navigation aid for this document. Guides come from a separate registry: the router consults them when selecting skills, and they are never workflow steps. Activities come from the catalog, which keeps the routing metadata; `scripts/list-skills` shows it next to the same descriptions.', '',
  'The router itself is documented in [engineering-router](../skills/engineering-router/SKILL.md). Personal and project skills depend on local configuration and are not included in this shared vendor index. Inspect those with `scripts/list-skills --target <repo>`.', '',
  '## Guides', '',
  'Consult these to understand which skills or flows a collection offers for a task.', '',
  '| Guide | Description |', '|---|---|',
  ...byId(guides).map(([id, g]) => `| ${link(id, g)} | ${describe(id, g)} |`), '',
  '## Orchestrators', '',
  'These execute a vendor workflow. Choose one when that workflow is explicitly requested.', '',
  '| Orchestrator | Description |', '|---|---|',
  ...orchestrators.map(([id, s]) => `| ${link(id, s)} | ${describe(id, s)} |`), '',
  '## Principles', '',
  'Focused decision rules that can support work in several phases.', '',
  '| Principle | Description | Activities |', '|---|---|---|',
  ...principles.map(([id, s]) => `| ${link(id, s)} | ${describe(id, s)} | ${activities(Catalog.arr(s.categories))} |`), '',
  '## Workflow and supporting skills', '',
  'Each skill is grouped under its first catalog category. The last column lists its additional activities, when present. This grouping is for navigation; all catalog categories remain available to the router.', '',
  ...groups.map(([c]) => `- [${label(c)}](#${anchor(label(c))})`), '');
for (const [c, list] of groups) {
  line(`### ${label(c)}`, '', categories[c], '', '| Skill | Description | Also applies to |', '|---|---|---|',
    ...list.map(([id, s]) => `| ${link(id, s)} | ${describe(id, s)} | ${activities(Catalog.arr(s.categories).slice(1))} |`), '');
}
line('## Keeping the index current', '',
  'After a reviewed catalog or vendor revision change, run `scripts/skill-index` and review the diff with the catalog change. `scripts/skill-index --check` reports a stale index; `scripts/selftest` runs it. `scripts/update` only reports upstream changes; review those before editing the catalog.');
const text = `${out.join('\n')}\n`;

warnings.forEach((w) => console.error(w));
const file = path.join(Catalog.ROOT, INDEX);
if (check) {
  const current = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : '';
  if (current !== text) {
    console.log(`${INDEX} is stale: run scripts/skill-index and review the diff`);
    process.exit(1);
  }
  console.log(`${INDEX} is current`);
} else {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, text);
  console.log(`wrote ${INDEX}`);
}
